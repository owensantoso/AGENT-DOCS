def audit_doc(doc_id: str, title: str, args: argparse.Namespace, timestamp: str, commit: str) -> str:
    status = status_for_new(args, "repo-health-audit")
    audit_started_at = f'"{timestamp}"' if status in {"in_progress", "completed"} else ""
    audit_ended_at = f'"{timestamp}"' if status == "completed" else ""
    return f"""---
type: repo-health-audit
id: {doc_id}
title: {title}
status: {status}
audit_kind: {args.audit_kind}
created_at: "{timestamp}"
updated_at: "{timestamp}"
audit_started_at: {audit_started_at}
audit_ended_at: {audit_ended_at}
owner: {args.owner}
scope: []
checks: []
