@dataclass
class Doc:
    path: Path
    relpath: str
    frontmatter: dict[str, object]
    content: str
    ids: list[str] = field(default_factory=list)

    @property
    def document_format_version(self) -> int:
        value = self.frontmatter.get("document_format_version")
        if value in (None, ""):
            return 1
        try:
            return int(str(value))
        except ValueError:
            return 0

    @property
    def aliases(self) -> list[str]:
        value = self.frontmatter.get("aliases")
        if isinstance(value, list):
            return [str(item).strip() for item in value if str(item).strip()]
        if isinstance(value, str) and value.strip():
            return [value.strip()]
        return []

    @property
    def canonical_id(self) -> str:
        value = self.frontmatter.get("id")
        if isinstance(value, str) and value:
            return value
        return self.ids[0] if self.ids else ""

    @property
    def primary_id(self) -> str:
        if self.document_format_version == DOCUMENT_FORMAT_VERSION and self.aliases:
            return self.aliases[0]
        return self.canonical_id

    @property
    def identity_keys(self) -> list[str]:
        values = [self.canonical_id, *self.aliases, *self.ids]
        return list(dict.fromkeys(value for value in values if value))

    @property
    def doc_type(self) -> str:
        value = self.frontmatter.get("type")
        if isinstance(value, str) and value:
            return value
        doc_id = self.primary_id
        prefix = doc_id.split("-", 1)[0] if doc_id else ""
        return TYPE_BY_PREFIX.get(prefix, "")

    @property
    def status(self) -> str:
        value = self.frontmatter.get("status")
        return value if isinstance(value, str) else ""

    @property
    def is_id_retirement(self) -> bool:
        return self.doc_type == "id-retirement"

    @property
    def title(self) -> str:
        value = self.frontmatter.get("title")
        if isinstance(value, str) and value:
            return value
        match = re.search(r"^#\s+(.+)$", self.content, re.MULTILINE)
        if match:
            title = match.group(1).strip()
            return re.sub(r"^(IDEA|RSCH|EVAL|DIAG|SPEC|PLAN|IMPL|ADR|LRN|EXPL|QST|CONC)-\d{4}(?:-\d{2})?\s*-\s*", "", title)
        return self.path.stem


@dataclass
class HealthIssue:
    severity: str
    code: str
    doc: str
    message: str
    detail: str = ""


@dataclass
class LinkRef:
    source: Path
    source_rel: str
    line: int
    raw: str
    href: str
    label: str
    kind: str
    href_start: int
    href_end: int
    target: Path | None
    target_rel: str
    status: str
    fragment: str = ""
    detail: str = ""

    def as_dict(self) -> dict[str, object]:
        return {
            "source": self.source_rel,
            "line": self.line,
            "kind": self.kind,
            "label": self.label,
            "href": self.href,
            "target": self.target_rel,
            "status": self.status,
            "fragment": self.fragment,
            "detail": self.detail,
        }


@dataclass
class TodoItem:
    state: str
    line: int
    task: str
    source: str
    path: str
    todo_id: str = ""
    status: str = ""
    owner: str = ""
    agent: str = ""
    skill: str = ""
    plan: str = ""
    brief: str = ""
    metadata: dict[str, str] = field(default_factory=dict)
    structured: bool = False
    raw: str = ""

    def as_dict(self) -> dict[str, object]:
        return {
            "id": self.todo_id,
            "status": self.status,
            "state": self.state,
            "owner": self.owner,
            "agent": self.agent,
            "skill": self.skill,
            "plan": self.plan,
            "brief": self.brief,
            "task": self.task,
            "source": self.source,
            "path": self.path,
            "line": self.line,
            "structured": self.structured,
            "metadata": self.metadata,
            "raw": self.raw,
        }


@dataclass
class AuditFinding:
    audit_path: str
    line: int
    finding_id: str
    severity: str
    status: str
    finding: str
    route: str
    follow_up: str
    resolution: str
    raw: str
    malformed: bool = False

    @property
    def reference(self) -> str:
        return f"{self.audit_path}#{self.finding_id}"

    def as_dict(self) -> dict[str, object]:
        return {
            "reference": self.reference,
            "audit_path": self.audit_path,
            "line": self.line,
            "id": self.finding_id,
            "severity": self.severity,
            "status": self.status,
            "finding": self.finding,
            "route": self.route,
            "follow_up": self.follow_up,
            "resolution": self.resolution,
            "raw": self.raw,
            "malformed": self.malformed,
        }


@dataclass
class ReviewItem:
    item_type: str
    code: str
    severity: str
    status: str
    reference: str
    source: str
    line: int
    message: str
    detail: str = ""
    route: str = ""
    follow_up: str = ""
    updated_at: str = ""
    age_days: int | None = None

    def as_dict(self) -> dict[str, object]:
        data: dict[str, object] = {
            "type": self.item_type,
            "code": self.code,
            "severity": self.severity,
            "status": self.status,
            "reference": self.reference,
            "source": self.source,
            "line": self.line,
            "message": self.message,
            "detail": self.detail,
            "route": self.route,
            "follow_up": self.follow_up,
        }
        if self.updated_at:
            data["updated_at"] = self.updated_at
        if self.age_days is not None:
            data["age_days"] = self.age_days
        return data


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=os.environ.get("AGENT_CONTINUITY_DOCS_PROG"),
        description="Scan and update Agent Continuity structured docs.",
    )
    parser.add_argument("--root", default="docs", help="Docs root to scan. Default: docs")

    sub = parser.add_subparsers(dest="command", required=True)

    next_cmd = sub.add_parser("next", help="Print the next legacy numeric ID for a doc family.")
    next_cmd.add_argument("family", choices=["idea", "rsch", "eval", "diag", "spec", "plan", "impl", "adr", "lrn", "expl", "qst", "conc", "audt", "todo"])
    next_cmd.add_argument("--plan", help="Required for impl IDs, e.g. PLAN-0034")

    new_cmd = sub.add_parser(
        "new",
        help="Create a new idea, research survey, evaluation, diagnostic, spec, plan, impl doc, ADR, learning, explainer, question, concept, or audit.",
    )
    new_cmd.add_argument(
        "family",
        choices=[
            "idea",
            "research",
            "rsch",
            "eval",
            "evaluation",
            "diag",
            "diagnostic",
            "spec",
            "plan",
            "impl",
            "adr",
            "learning",
            "lrn",
            "explainer",
            "expl",
            "question",
            "qst",
            "concept",
            "conc",
            "audit",
        ],
    )
    new_cmd.add_argument("title")
    new_cmd.add_argument("--domain", default="product")
    new_cmd.add_argument("--spec-type", default="feature")
    new_cmd.add_argument("--status", default="draft")
    new_cmd.add_argument("--owner", default="")
    new_cmd.add_argument("--source-type", default="conversation")
    new_cmd.add_argument("--source-link", default="")
    new_cmd.add_argument("--plan", help="Parent plan UUID or legacy alias for impl docs")
    new_cmd.add_argument("--spec", action="append", default=[], help="Related SPEC-* ID. Repeatable.")
    new_cmd.add_argument("--kind", "--audit-kind", dest="audit_kind", choices=sorted(AUDIT_KINDS), help="Audit kind for repo-health audit docs.")

    retire_cmd = sub.add_parser("retire-id", help="Permanently retire the current next IMPL ID with a typed tombstone.")
    retire_cmd.add_argument("id", help="IMPL-* ID to retire, e.g. IMPL-0034-02")
    retire_cmd.add_argument("--plan", required=True, help="Live parent plan, e.g. PLAN-0034")
    retire_cmd.add_argument("--reason", required=True, help="Non-empty reason for retiring the ID.")
    retire_cmd.add_argument("--source-type", required=True, help="Provenance source type.")
    retire_cmd.add_argument("--source-link", default="", help="Provenance link; required unless --source-notes is non-empty.")
    retire_cmd.add_argument("--source-notes", default="", help="Provenance notes; required unless --source-link is non-empty.")
    retire_cmd.add_argument("--write", action="store_true", help="Write the tombstone. Preview is the default.")

    format_cmd = sub.add_parser("format-status", help="Report document-format versions and UUID migration readiness.")
    format_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    format_cmd.add_argument("--exclude", action="append", default=[], help="Glob-style docs-root path to ignore. Repeatable.")

    migrate_cmd = sub.add_parser("migrate-uuids", help="Prepare or apply a committed document-format-v2 UUID migration plan.")
    migrate_mode = migrate_cmd.add_mutually_exclusive_group(required=True)
    migrate_mode.add_argument("--prepare-plan", help="Create an immutable migration plan at this repository-relative path.")
    migrate_mode.add_argument("--plan", help="Preview or apply this committed migration plan.")
    migrate_cmd.add_argument("--exclude", action="append", default=[], help="Glob-style docs-root path to ignore while preparing. Repeatable.")
    migrate_cmd.add_argument("--write", action="store_true", help="Write the plan or apply the migration. Preview is the default.")
    migrate_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    status_cmd = sub.add_parser("status", help="Show doc statuses.")
    status_cmd.add_argument("id", nargs="?")

    show_cmd = sub.add_parser("show", help="Show one doc with related docs, linked paths, and local TODOs.")
    show_cmd.add_argument("id", help="Doc ID or repo/docs path.")
    show_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    set_status_cmd = sub.add_parser("set-status", help="Update a doc status in frontmatter.")
    set_status_cmd.add_argument("id")
    set_status_cmd.add_argument("status", choices=sorted(COMMON_STATUSES))

    todos_cmd = sub.add_parser("todos", help="List Markdown task checkboxes and structured TODO-* items.")
    todos_cmd.add_argument("id", nargs="?", help="Optional doc ID/path or TODO-* ID.")
    todos_cmd.add_argument("--all", action="store_true", help="Include completed todos.")
    todos_cmd.add_argument("--status", help="Filter structured todos by lifecycle status.")
    todos_cmd.add_argument("--owner", help="Filter structured todos by owner.")
    todos_cmd.add_argument("--agent", help="Filter structured todos by agent/session identifier.")
    todos_cmd.add_argument("--skill", help="Filter structured todos by skill.")
    todos_cmd.add_argument("--plan", help="Filter structured todos by PLAN-* reference.")
    todos_cmd.add_argument("--brief", help="Filter structured todos by IMPL-* reference.")
    todos_cmd.add_argument("--structured-only", action="store_true", help="Only list structured TODO-* items.")
    todos_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    sub.add_parser("update", help="Regenerate docs registries and todo dashboard.")
    sub.add_parser("check", help="Validate IDs, statuses, and generated docs.")
    check_todos_cmd = sub.add_parser("check-todos", help="Validate structured TODO-* metadata.")
    check_todos_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    check_todos_cmd.add_argument("--strict", action="store_true", help="Warn on optional metadata that improves routing and freshness.")

    review_cmd = sub.add_parser("review", help="Show open audit findings and stale open-loop docs.")
    review_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    review_cmd.add_argument("--type", choices=["audit-findings", "todos", "docs"], help="Filter review items by source type.")
    review_cmd.add_argument("--status", help="Filter review items by status.")
    review_cmd.add_argument("--severity", choices=sorted(AUDIT_FINDING_SEVERITIES), help="Filter review items by severity.")
    review_cmd.add_argument("--limit", type=int, help="Limit number of review items.")
    review_cmd.add_argument("--width", type=int, help="Output width for human-readable text.")
    review_cmd.add_argument("--stale-days", type=int, default=14, help="Flag open-loop docs/todos not updated in this many days. Default: 14")

    health_cmd = sub.add_parser("health", help="Show advisory docs freshness and workflow warnings.")
    health_cmd.add_argument("--stale-days", type=int, default=14, help="Flag selected docs not updated in this many days. Default: 14")
    health_cmd.add_argument("--commit-threshold", type=int, default=10, help="Flag docs reviewed this many commits behind HEAD. Default: 10")
    health_cmd.add_argument("--audit-days", type=int, default=30, help="Flag missing or old repo-health audits after this many days. Default: 30")
    health_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    health_cmd.add_argument("--write", action="store_true", help="Write docs/HEALTH.md as a generated advisory view.")

    roadmap_cmd = sub.add_parser("roadmap", help="Show generated plan roadmap ordered by frontmatter sequence.")
    roadmap_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    roadmap_cmd.add_argument("--write", action="store_true", help="Write docs/ROADMAP-VIEW.md as a generated plan-order view.")

    view_cmd = sub.add_parser("view", help="Print and refresh a generated Markdown view.")
    view_cmd.add_argument("name", choices=["ideas", "specs", "learnings", "explainers", "questions", "concepts", "registry", "todos", "areas", "audits", "roadmap", "health"])
    view_cmd.add_argument("--stale-days", type=int, default=14, help="Health view stale-days threshold. Default: 14")
    view_cmd.add_argument("--commit-threshold", type=int, default=10, help="Health view commit threshold. Default: 10")
    view_cmd.add_argument("--audit-days", type=int, default=30, help="Health view audit threshold. Default: 30")

    links_cmd = sub.add_parser("links", help="List repo-local and external links found in Markdown docs.")
    links_cmd.add_argument("target", nargs="?", help="Optional source path/ID or target path/ID filter.")
    links_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    backlinks_cmd = sub.add_parser("backlinks", help="List docs that link to a path or ID.")
    backlinks_cmd.add_argument("target", help="Target path or stable ID.")
    backlinks_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    check_links_cmd = sub.add_parser("check-links", help="Report broken repo-local links.")
    check_links_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    orphans_cmd = sub.add_parser("orphans", help="Report Markdown docs with no inbound links.")
    orphans_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    orphans_cmd.add_argument("--include-generated", action="store_true", help="Include generated views in orphan output.")
    orphans_cmd.add_argument("--exclude", action="append", default=[], help="Glob-style docs-root path to ignore. Repeatable.")

    normalize_cmd = sub.add_parser("normalize-links", help="Normalize repo-local Markdown links.")
    normalize_cmd.add_argument("--style", choices=["relative"], default="relative")
    normalize_cmd.add_argument("--dry-run", action="store_true", help="Preview changes without writing. This is the default unless --write is passed.")
    normalize_cmd.add_argument("--write", action="store_true", help="Rewrite files.")
    normalize_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    move_cmd = sub.add_parser("move", help="Move a doc and rewrite Markdown backlinks.")
    move_cmd.add_argument("old")
    move_cmd.add_argument("new")
    move_cmd.add_argument("--dry-run", action="store_true", help="Preview changes without writing. This is the default unless --write is passed.")
    move_cmd.add_argument("--write", action="store_true", help="Move the file and rewrite backlinks.")
    move_cmd.add_argument("--allow-historical", action="store_true", help="Allow moving legacy plan/spec paths.")
    move_cmd.add_argument("--json", action="store_true", help="Print machine-readable JSON.")

    return parser.parse_args()


def docs_root(value: str) -> Path:
    root = Path(value)
    if not root.exists() and Path.cwd().name == "docs":
        root = Path.cwd()
    return root


def read_docs(root: Path, *, skip_decode_errors: bool = False, skip_symlinks: bool = False) -> list[Doc]:
    docs: list[Doc] = []
    if not root.exists():
        return docs
    for path in sorted(root.rglob("*.md")):
        if any(part in {".git", "node_modules", ".generated"} for part in path.parts):
            continue
        if skip_symlinks and path.is_symlink():
            continue
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            if skip_decode_errors and not path.read_bytes().startswith(b"---\n"):
                continue
            raise
        frontmatter, content = parse_frontmatter(text)
        frontmatter_id = frontmatter.get("id")
        ids = find_ids(path.name)
        if isinstance(frontmatter_id, str):
            ids.extend(find_ids(frontmatter_id))
        aliases = frontmatter.get("aliases")
        if isinstance(aliases, list):
            for alias in aliases:
                ids.extend(find_ids(str(alias)))
        elif isinstance(aliases, str):
            ids.extend(find_ids(aliases))
        ids = sorted(set(ids))
        docs.append(Doc(path=path, relpath=path.relative_to(root).as_posix(), frontmatter=frontmatter, content=content, ids=ids))
    return docs


def repo_root_for(root: Path) -> Path:
    return root.resolve().parent


def relative_to_root(path: Path, root: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        try:
            return path.resolve().relative_to(repo_root_for(root)).as_posix()
        except ValueError:
            return path.as_posix()


def line_number(text: str, offset: int) -> int:
    return text.count("\n", 0, offset) + 1


def split_href(href: str) -> tuple[str, str, str]:
    fragment = ""
    path_and_query = href
    if "#" in path_and_query:
        path_and_query, fragment = path_and_query.split("#", 1)
    query = ""
    path_part = path_and_query
    if "?" in path_part:
        path_part, query = path_part.split("?", 1)
    suffix = ""
    if query:
        suffix += f"?{query}"
    if fragment:
        suffix += f"#{fragment}"
    return path_part, suffix, fragment


def is_external_href(href: str) -> bool:
    return bool(re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", href)) or href.startswith("//")


def is_path_like_autolink(href: str) -> bool:
    return "/" in href or href.endswith(".md") or href.startswith((".", "#"))


def resolve_path_input(value: str, root: Path, docs: list[Doc] | None = None) -> Path:
    if docs:
        doc = find_any_doc(docs, value)
        if doc:
            return doc.path
    path = Path(value)
    if path.is_absolute():
        return path
    parts = path.parts
    if parts and parts[0] == root.name:
        return root.parent / path
    return root / path


def resolve_href(href: str, source: Path, root: Path) -> tuple[Path | None, str, str, str]:
    if not href:
        return None, "", "empty", ""
    if is_external_href(href):
        return None, "", "external", ""
    if href.startswith("#"):
        return source, relative_to_root(source, root), "ok", href[1:]

    path_part, _, fragment = split_href(href)
    if not path_part:
        return source, relative_to_root(source, root), "ok", fragment

    decoded = unquote(path_part)
    candidate: Path
    status = "ok"
    root_resolved = root.resolve()
    repo_root = repo_root_for(root)

    if decoded.startswith("/"):
        stripped = decoded.lstrip("/")
        if stripped.startswith(f"{root.name}/"):
            candidate = repo_root / stripped
        else:
            candidate = root / stripped
        status = "root-relative"
    else:
        path = Path(decoded)
        if path.is_absolute():
            candidate = path
            try:
                candidate.resolve().relative_to(repo_root)
                status = "absolute-repo-local"
            except ValueError:
                return candidate, candidate.as_posix(), "outside-repo", fragment
        else:
            candidate = source.parent / path

    candidate = candidate.resolve()
    if candidate.is_dir():
        for index_name in ("README.md", "index.md"):
            index = candidate / index_name
            if index.exists():
                candidate = index.resolve()
                break
        else:
            return candidate, relative_to_root(candidate, root), "directory-no-index", fragment
    if not candidate.exists():
        return candidate, relative_to_root(candidate, root), "missing", fragment
    try:
        candidate.relative_to(root_resolved)
    except ValueError:
        try:
            candidate.relative_to(repo_root)
        except ValueError:
            return candidate, candidate.as_posix(), "outside-repo", fragment
    return candidate, relative_to_root(candidate, root), status, fragment


def markdown_anchor_slug(text: str) -> str:
    slug = text.strip().lower()
    slug = re.sub(r"`([^`]*)`", r"\1", slug)
    slug = re.sub(r"<[^>]+>", "", slug)
    slug = re.sub(r"[^\w\s-]", "", slug, flags=re.UNICODE)
    slug = re.sub(r"\s+", "-", slug)
    slug = re.sub(r"-+", "-", slug)
    return slug.strip("-")


def markdown_anchor_exists(path: Path, fragment: str) -> bool:
    if not fragment:
        return True
    decoded = unquote(fragment).strip()
    if re.fullmatch(r"L\d+(?:-L\d+)?", decoded):
        return True
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return False
    anchors = set()
    for line in text.splitlines():
        heading = re.match(r"^\s{0,3}#{1,6}\s+(.+?)\s*#*\s*$", line)
        if heading:
            title = re.sub(r"\s+\{#([^}]+)\}\s*$", "", heading.group(1))
            slug = markdown_anchor_slug(title)
            if slug:
                anchors.add(slug)
            explicit = re.search(r"\{#([^}]+)\}\s*$", heading.group(1))
            if explicit:
                anchors.add(explicit.group(1))
    return decoded in anchors


MD_LINK_RE = re.compile(r"(!?)\[([^\]\n]*)\]\(([^)\s]+)([^)]*)\)")
WIKI_LINK_RE = re.compile(r"(!?)\[\[([^\]|\n]+)(?:\|([^\]\n]+))?\]\]")
AUTOLINK_RE = re.compile(r"<([^<>\s]+)>")


def markdown_ignored_ranges(text: str) -> list[tuple[int, int]]:
    ranges: list[tuple[int, int]] = []
    in_fence = False
    fence_start = 0
    offset = 0
    for line in text.splitlines(keepends=True):
        stripped = line.lstrip()
        if stripped.startswith(("```", "~~~")):
            if in_fence:
                ranges.append((fence_start, offset + len(line)))
                in_fence = False
            else:
                fence_start = offset
                in_fence = True
        if not in_fence:
            for match in re.finditer(r"`[^`\n]+`", line):
                ranges.append((offset + match.start(), offset + match.end()))
        offset += len(line)
    if in_fence:
        ranges.append((fence_start, len(text)))
    return ranges


def in_ignored_markdown_range(offset: int, ranges: list[tuple[int, int]]) -> bool:
    return any(start <= offset < end for start, end in ranges)


def link_refs_for_doc(doc: Doc, root: Path) -> list[LinkRef]:
    refs: list[LinkRef] = []
    text = doc.path.read_text(encoding="utf-8")
    ignored_ranges = markdown_ignored_ranges(text)

    for match in MD_LINK_RE.finditer(text):
        if in_ignored_markdown_range(match.start(), ignored_ranges):
            continue
        href = match.group(3)
        target, target_rel, status, fragment = resolve_href(href, doc.path, root)
        refs.append(
            LinkRef(
                source=doc.path,
                source_rel=doc.relpath,
                line=line_number(text, match.start()),
                raw=match.group(0),
                href=href,
                label=match.group(2),
                kind="markdown-image" if match.group(1) else "markdown-link",
                href_start=match.start(3),
                href_end=match.end(3),
                target=target,
                target_rel=target_rel,
                status=status,
                fragment=fragment,
            )
        )

    for match in WIKI_LINK_RE.finditer(text):
        if in_ignored_markdown_range(match.start(), ignored_ranges):
            continue
        href = match.group(2)
        wiki_path = href.split("#", 1)[0]
        target, target_rel, status, fragment = resolve_href(wiki_path, doc.path, root)
        refs.append(
            LinkRef(
                source=doc.path,
                source_rel=doc.relpath,
                line=line_number(text, match.start()),
                raw=match.group(0),
                href=href,
                label=match.group(3) or href,
                kind="wiki-image" if match.group(1) else "wiki-link",
                href_start=match.start(2),
                href_end=match.end(2),
                target=target,
                target_rel=target_rel,
                status=status if status != "external" else "unsupported-wiki-link",
                fragment=fragment,
                detail="Wikilinks are parsed for visibility but are not the canonical link format.",
            )
        )

    for match in AUTOLINK_RE.finditer(text):
        if in_ignored_markdown_range(match.start(), ignored_ranges):
            continue
        href = match.group(1)
        if href.startswith(("http://", "https://", "mailto:")):
            continue
        if not is_path_like_autolink(href):
            continue
        target, target_rel, status, fragment = resolve_href(href, doc.path, root)
        refs.append(
            LinkRef(
                source=doc.path,
                source_rel=doc.relpath,
                line=line_number(text, match.start()),
                raw=match.group(0),
                href=href,
                label=href,
                kind="autolink",
                href_start=match.start(1),
                href_end=match.end(1),
                target=target,
                target_rel=target_rel,
                status=status,
                fragment=fragment,
            )
        )

    return sorted(refs, key=lambda ref: (ref.source_rel, ref.line, ref.href_start))


def link_graph(root: Path, docs: list[Doc]) -> list[LinkRef]:
    refs: list[LinkRef] = []
    for doc in docs:
        refs.extend(link_refs_for_doc(doc, root))
    return refs


def is_generated_doc(doc: Doc) -> bool:
    return doc.doc_type == "generated-view" or doc.path.name in {
        "IDEAS.md",
        "CONCEPTS.md",
        "SPECS.md",
        "DOCS-REGISTRY.md",
        "TODOS.md",
        "AREAS.md",
        "AUDITS.md",
        "ROADMAP-VIEW.md",
        "HEALTH.md",
    }


def link_matches_target(ref: LinkRef, target: Path) -> bool:
    return ref.target is not None and ref.target.resolve() == target.resolve()


def markdown_link_refs(refs: list[LinkRef]) -> list[LinkRef]:
    return [ref for ref in refs if ref.kind in {"markdown-link", "markdown-image", "autolink"} and ref.target is not None]


def relative_href(source: Path, target: Path, suffix: str = "") -> str:
    rel = os.path.relpath(target.resolve(), start=source.resolve().parent)
    return quote(Path(rel).as_posix(), safe="/") + suffix


def format_link_rows(refs: list[LinkRef]) -> str:
    if not refs:
        return "No links found."
    return "\n".join(
        f"{ref.status}\t{ref.kind}\t{ref.source_rel}:{ref.line}\t{ref.href}\t{ref.target_rel}"
        for ref in refs
    )


def broken_link_refs(refs: list[LinkRef]) -> list[LinkRef]:
    broken_statuses = {"missing", "directory-no-index", "outside-repo", "empty", "unsupported-wiki-link"}
    return [ref for ref in refs if ref.status in broken_statuses]


def orphan_docs(root: Path, docs: list[Doc], refs: list[LinkRef], include_generated: bool = False, excludes: list[str] | None = None) -> list[Doc]:
    inbound = {ref.target.resolve() for ref in refs if ref.target is not None and ref.status in {"ok", "root-relative", "absolute-repo-local"}}
    result: list[Doc] = []
    excludes = excludes or []
    for doc in docs:
        if not include_generated and is_generated_doc(doc):
            continue
        if doc.frontmatter.get("docs_meta_ignore_orphan") or doc.frontmatter.get("orphan_ok"):
            continue
        if any(fnmatch.fnmatch(doc.relpath, pattern) for pattern in excludes):
            continue
        if doc.path.name == "README.md":
            continue
        if doc.path.resolve() not in inbound:
            result.append(doc)
    return sorted(result, key=lambda doc: doc.relpath)


def print_json_or_text(payload: object, text: str, use_json: bool) -> None:
    if use_json:
        print(json.dumps(payload, indent=2))
    else:
        print(text)


def rewrite_markdown_hrefs(path: Path, replacements: list[tuple[int, int, str]], write: bool) -> str:
    text = path.read_text(encoding="utf-8")
    for start, end, href in sorted(replacements, reverse=True):
        text = text[:start] + href + text[end:]
    if write:
        path.write_text(text, encoding="utf-8")
    return text


def id_retirement_paths(docs: list[Doc]) -> set[Path]:
    return {doc.path.resolve() for doc in docs if doc.is_id_retirement}


def planned_link_rewrites(
    refs: list[LinkRef],
    write: bool = False,
    excluded_sources: set[Path] | None = None,
) -> list[dict[str, object]]:
    excluded_sources = excluded_sources or set()
    by_file: dict[Path, list[tuple[int, int, str, LinkRef]]] = {}
    for ref in refs:
        if ref.source.resolve() in excluded_sources:
            continue
        _, suffix, _ = split_href(ref.href)
        if not ref.target or ref.kind not in {"markdown-link", "markdown-image", "autolink"}:
            continue
        new_href = relative_href(ref.source, ref.target, suffix)
        if new_href == ref.href:
            continue
        by_file.setdefault(ref.source, []).append((ref.href_start, ref.href_end, new_href, ref))

    changes: list[dict[str, object]] = []
    for path, replacements in sorted(by_file.items(), key=lambda item: item[0].as_posix()):
        rewrite_markdown_hrefs(path, [(start, end, href) for start, end, href, _ in replacements], write)
        for _, _, href, ref in replacements:
            changes.append(
                {
                    "file": ref.source_rel,
                    "line": ref.line,
                    "from": ref.href,
                    "to": href,
                    "target": ref.target_rel,
                }
            )
    return changes


def prose_mentions(root: Path, old_path: Path, refs: list[LinkRef]) -> list[dict[str, object]]:
    old_rel = relative_to_root(old_path, root)
    link_spans = {(ref.source.resolve(), ref.line, ref.href) for ref in refs}
    mentions: list[dict[str, object]] = []
    needles = {old_rel, old_path.name}
    for path in sorted(root.rglob("*.md")):
        text = path.read_text(encoding="utf-8")
        rel = relative_to_root(path, root)
        for idx, line in enumerate(text.splitlines(), start=1):
            if any(needle and needle in line for needle in needles):
                if any(item[0] == path.resolve() and item[1] == idx for item in link_spans):
                    continue
                mentions.append({"file": rel, "line": idx, "text": line.strip()})
    return mentions


def is_historical_move(path: Path, root: Path) -> bool:
    rel = relative_to_root(path, root)
    name = path.name
    return bool(re.match(r"plan-\d", name)) or bool(re.match(r"impl-plan-", name)) or rel.startswith("plans/plan-")


def perform_move(root: Path, docs: list[Doc], old_value: str, new_value: str, write: bool, allow_historical: bool) -> dict[str, object]:
    old_path = resolve_path_input(old_value, root, docs).resolve()
    new_path = resolve_path_input(new_value, root, docs).resolve()
    if not old_path.exists():
        raise SystemExit(f"Move source does not exist: {old_value}")
    if new_path.exists():
        raise SystemExit(f"Move destination already exists: {new_value}")
    try:
        old_path.relative_to(root.resolve())
        new_path.relative_to(root.resolve())
    except ValueError:
        raise SystemExit("agent-continuity docs move only supports paths inside the docs root")
    immutable_sources = id_retirement_paths(docs)
    if write:
        protected = [
            doc
            for doc in docs
            if doc.is_id_retirement
            and (doc.path.resolve() == old_path or old_path in doc.path.resolve().parents)
        ]
        if protected:
            paths = ", ".join(doc.relpath for doc in protected)
            raise SystemExit(f"Refusing to move source containing immutable id-retirement tombstone: {paths}")
    if is_historical_move(old_path, root) and not allow_historical:
        raise SystemExit("Refusing to move historical plan/brief path without --allow-historical")

    refs = link_graph(root, docs)
    if write:
        blocking_refs: list[str] = []
        for ref in refs:
            if ref.source.resolve() not in immutable_sources or ref.target is None:
                continue
            resolved_target = ref.target.resolve()
            if resolved_target == old_path:
                blocking_refs.append(f"{ref.source_rel}:{ref.line} links to the move source {relative_to_root(old_path, root)}")
            elif old_path in resolved_target.parents:
                blocking_refs.append(
                    f"{ref.source_rel}:{ref.line} links to {ref.target_rel} beneath the move source {relative_to_root(old_path, root)}"
                )
        if blocking_refs:
            detail = "; ".join(blocking_refs)
            raise SystemExit(
                "Refusing move because an immutable id-retirement reference would break: "
                f"{detail}. Keep the move source in place or choose a migration that preserves the referenced paths."
            )

    replacements_by_file: dict[Path, list[tuple[int, int, str]]] = {}
    changes: list[dict[str, object]] = []
    for ref in markdown_link_refs(refs):
        if ref.source.resolve() in immutable_sources:
            continue
        if ref.status not in {"ok", "root-relative", "absolute-repo-local"}:
            continue
        _, suffix, _ = split_href(ref.href)
        source_after_move = new_path if ref.source.resolve() == old_path else ref.source
        target_after_move = new_path if ref.target and ref.target.resolve() == old_path else ref.target
        if ref.source.resolve() != old_path and (not ref.target or ref.target.resolve() != old_path):
            continue
        if not target_after_move:
            continue
        new_href = relative_href(source_after_move, target_after_move, suffix)
        if new_href == ref.href:
            continue
        replacements_by_file.setdefault(ref.source, []).append((ref.href_start, ref.href_end, new_href))
        changes.append({"file": ref.source_rel, "line": ref.line, "from": ref.href, "to": new_href})

    mentions = prose_mentions(root, old_path, refs)
    if write:
        for path, replacements in replacements_by_file.items():
            rewrite_markdown_hrefs(path, replacements, True)
        new_path.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(old_path), str(new_path))

    return {
        "old": relative_to_root(old_path, root),
        "new": relative_to_root(new_path, root),
        "write": write,
        "link_changes": changes,
        "prose_mentions": mentions,
    }


def parse_frontmatter(text: str) -> tuple[dict[str, object], str]:
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text
    raw = text[4:end].splitlines()
    content = text[end + 4 :].lstrip("\n")
    data: dict[str, object] = {}
    current_key = ""
    for line in raw:
        if not line.strip():
            continue
        if line.startswith("  - ") and current_key:
            value = str(line[4:].strip()).strip('"')
            if not isinstance(data.get(current_key), list):
                data[current_key] = []
            data[current_key].append(value)
            continue
        if line.startswith("  ") and current_key:
            nested = line.strip()
            if ":" in nested:
                child_key, child_value = nested.split(":", 1)
                if not isinstance(data.get(current_key), dict):
                    data[current_key] = {}
                target = data[current_key]
                if isinstance(target, dict):
                    target[child_key.strip()] = parse_scalar(child_value.strip())
            continue
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip()
        current_key = key
        data[key] = parse_scalar(value)
    return data, content


def parse_scalar(value: str) -> object:
    if value == "[]":
        return []
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [item.strip().strip('"').strip("'") for item in inner.split(",") if item.strip()]
    if value == "":
        return ""
    if value.startswith('"') and value.endswith('"'):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            pass
        else:
            if isinstance(parsed, str):
                return parsed
    return value.strip('"')


def find_ids(text: str) -> list[str]:
    ids: list[str] = []
    for pattern in ID_PATTERNS.values():
        for match in pattern.finditer(text):
            ids.append(match.group(0))
    return ids


def slugify(title: str) -> str:
    slug = title.lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    return slug.strip("-") or "untitled"


def now_string() -> str:
    now = dt.datetime.now().astimezone()
    zone = now.tzname() or "local"
    offset = now.strftime("%z")
    return now.strftime(f"%Y-%m-%d %H:%M:%S {zone} {offset}")


def new_uuid7() -> str:
    """Return an RFC 9562 UUIDv7 without requiring Python 3.14."""
    unix_ms = int(time.time() * 1000) & ((1 << 48) - 1)
    rand_a = secrets.randbits(12)
    rand_b = secrets.randbits(62)
    value = (unix_ms << 80) | (0x7 << 76) | (rand_a << 64) | (0b10 << 62) | rand_b
    return str(uuid.UUID(int=value))


def is_uuid7(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        parsed = uuid.UUID(value)
    except ValueError:
        return False
    return parsed.version == 7 and parsed.variant == uuid.RFC_4122 and str(parsed) == value.lower()


def sha256_bytes(value: bytes) -> str:
    return f"sha256:{hashlib.sha256(value).hexdigest()}"


def git_head(cwd: Path | None = None) -> str:
    try:
        result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=cwd, check=True, capture_output=True, text=True)
        return result.stdout.strip()
    except Exception:
        return ""


def git_commit_count_since(commit: str) -> int | None:
    if not commit:
        return None
    try:
        result = subprocess.run(["git", "rev-list", "--count", f"{commit}..HEAD"], check=True, capture_output=True, text=True)
        return int(result.stdout.strip())
    except Exception:
        return None


def git_repo_root(root: Path) -> Path:
    try:
        result = subprocess.run(
            ["git", "-C", str(root.resolve()), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        detail = exc.stderr.strip() or exc.stdout.strip()
        raise SystemExit(f"UUID migration requires a Git repository: {detail}") from exc
    return Path(result.stdout.strip()).resolve()


def repo_relative_path(value: str, repo_root: Path) -> tuple[Path, str]:
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = repo_root / candidate
    resolved = candidate.resolve()
    try:
        relative = resolved.relative_to(repo_root).as_posix()
    except ValueError as exc:
        raise SystemExit(f"Refusing migration path outside repository: {value}") from exc
    return resolved, relative


def atomic_write_bytes(path: Path, value: bytes, refuse_existing: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if refuse_existing and path.exists():
        raise SystemExit(f"Refusing to overwrite existing file: {path}")
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    temporary = path.with_name(f".{path.name}.tmp-{new_uuid7()}")
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(value)
                handle.flush()
                os.fsync(handle.fileno())
        except Exception:
            try:
                os.close(descriptor)
            except OSError:
                pass
            raise
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def migration_excluded(relpath: str, excludes: list[str]) -> bool:
    patterns = [*DEFAULT_MIGRATION_EXCLUDES, *excludes]
    return any(fnmatch.fnmatch(relpath, pattern) for pattern in patterns)


def format_docs(root: Path, excludes: list[str]) -> list[Doc]:
    return [
        doc
        for doc in read_docs(root, skip_decode_errors=True, skip_symlinks=True)
        if doc.doc_type in KNOWN_DOC_TYPES
        and doc.doc_type != "generated-view"
        and not migration_excluded(doc.relpath, excludes)
    ]


def format_status_payload(root: Path, excludes: list[str]) -> dict[str, object]:
    documents: list[dict[str, object]] = []
    counts = {"v1": 0, "v2": 0, "invalid": 0}
    for doc in format_docs(root, excludes):
        errors = validate_document_identity(doc)
        if doc.document_format_version == 1:
            state = "v1"
        elif doc.document_format_version == DOCUMENT_FORMAT_VERSION and not errors:
            state = "v2"
        else:
            state = "invalid"
        counts[state] += 1
        documents.append(
            {
                "path": doc.relpath,
                "state": state,
                "id": doc.canonical_id,
                "aliases": doc.aliases,
                "errors": errors,
            }
        )
    return {
        "target_version": DOCUMENT_FORMAT_VERSION,
        "counts": counts,
        "migration_required": bool(counts["v1"] or counts["invalid"]),
        "documents": documents,
    }


def format_status_text(payload: dict[str, object]) -> str:
    counts = payload["counts"]
    assert isinstance(counts, dict)
    return (
        f"Document format target: v{payload['target_version']}\n"
        f"v1: {counts['v1']}\n"
        f"v2: {counts['v2']}\n"
        f"invalid: {counts['invalid']}\n"
        f"migration_required: {str(payload['migration_required']).lower()}"
    )


def v1_aliases(doc: Doc) -> list[str]:
    aliases = list(doc.aliases)
    value = doc.frontmatter.get("id")
    if isinstance(value, str) and value and value not in aliases:
        aliases.insert(0, value)
    return aliases


def migrate_document_text(text: str, canonical_id: str, aliases: list[str]) -> str:
    if not text.startswith("---\n"):
        raise SystemExit("Cannot migrate a document without YAML frontmatter")
    end = text.find("\n---", 4)
    if end == -1:
        raise SystemExit("Cannot migrate a document with unterminated YAML frontmatter")
    lines = text[4:end].splitlines()
    stripped: list[str] = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("aliases:"):
            index += 1
            while index < len(lines) and (lines[index].startswith("  ") or not lines[index].strip()):
                index += 1
            continue
        if line.startswith("document_format_version:"):
            index += 1
            continue
        stripped.append(line)
        index += 1

    identity_lines = [
        f"document_format_version: {DOCUMENT_FORMAT_VERSION}",
        f"id: {canonical_id}",
    ]
    if aliases:
        identity_lines.append("aliases:")
        identity_lines.extend(f"  - {json.dumps(alias, ensure_ascii=False)}" for alias in aliases)
    else:
        identity_lines.append("aliases: []")

    id_index = next((i for i, line in enumerate(stripped) if line.startswith("id:")), None)
    if id_index is not None:
        stripped[id_index : id_index + 1] = identity_lines
    else:
        type_index = next((i for i, line in enumerate(stripped) if line.startswith("type:")), -1)
        insertion = type_index + 1
        stripped[insertion:insertion] = identity_lines
    return "---\n" + "\n".join(stripped) + text[end:]


def git_worktree_inventory(repo_root: Path) -> list[dict[str, str]]:
    result = subprocess.run(
        ["git", "-C", str(repo_root), "worktree", "list", "--porcelain"],
        check=True,
        capture_output=True,
        text=True,
    )
    rows: list[dict[str, str]] = []
    current: dict[str, str] = {}
    for line in [*result.stdout.splitlines(), ""]:
        if not line:
            if current:
                rows.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "HEAD":
            current["head"] = value
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
        elif key == "detached":
            current["branch"] = "(detached)"
    return rows


def prepare_uuid_migration(root: Path, plan_value: str, excludes: list[str], write: bool) -> dict[str, object]:
    repo_root = git_repo_root(root)
    plan_path, plan_rel = repo_relative_path(plan_value, repo_root)
    source_root = root.resolve().relative_to(repo_root).as_posix() or "."
    candidates = [doc for doc in format_docs(root, excludes) if doc.document_format_version == 1]
    invalid = [
        doc
        for doc in format_docs(root, excludes)
        if doc.document_format_version not in {1, DOCUMENT_FORMAT_VERSION}
        or (doc.document_format_version == DOCUMENT_FORMAT_VERSION and validate_document_identity(doc))
    ]
    if invalid:
        raise SystemExit("Refusing UUID plan because invalid document formats exist: " + ", ".join(doc.relpath for doc in invalid))
    identity_errors = validate_identity_graph(format_docs(root, excludes))
    if identity_errors:
        raise SystemExit("Refusing UUID plan because identities are ambiguous: " + "; ".join(identity_errors))

    documents: list[dict[str, object]] = []
    for doc in candidates:
        canonical_id = new_uuid7()
        aliases = v1_aliases(doc)
        preimage = doc.path.read_bytes()
        postimage = migrate_document_text(preimage.decode("utf-8"), canonical_id, aliases).encode("utf-8")
        documents.append(
            {
                "path": doc.path.resolve().relative_to(repo_root).as_posix(),
                "preimage_sha256": sha256_bytes(preimage),
                "postimage_sha256": sha256_bytes(postimage),
                "uuid": canonical_id,
                "aliases": aliases,
            }
        )

    payload: dict[str, object] = {
        "schema_version": DOCUMENT_MIGRATION_SCHEMA_VERSION,
        "migration_type": DOCUMENT_MIGRATION_TYPE,
        "migration_id": new_uuid7(),
        "document_format_from": 1,
        "document_format_to": DOCUMENT_FORMAT_VERSION,
        "prepared_at": dt.datetime.now().astimezone().isoformat(),
        "prepared_base_commit": git_head(repo_root),
        "source_root": source_root,
        "excludes": [*DEFAULT_MIGRATION_EXCLUDES, *excludes],
        "inventoried_worktrees": git_worktree_inventory(repo_root),
        "receipt_path": f"{plan_rel}.receipt.json",
        "documents": documents,
    }
    if write:
        atomic_write_bytes(plan_path, (json.dumps(payload, indent=2) + "\n").encode("utf-8"), refuse_existing=True)
    return payload


def load_migration_plan(plan_path: Path) -> dict[str, object]:
    try:
        payload = json.loads(plan_path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SystemExit(f"Migration plan does not exist: {plan_path}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid migration plan JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise SystemExit("Migration plan must be a JSON object")
    if payload.get("schema_version") != DOCUMENT_MIGRATION_SCHEMA_VERSION:
        raise SystemExit(f"Unsupported migration plan schema_version: {payload.get('schema_version')!r}")
    if payload.get("migration_type") != DOCUMENT_MIGRATION_TYPE:
        raise SystemExit(f"Unsupported migration type: {payload.get('migration_type')!r}")
    if not is_uuid7(payload.get("migration_id")):
        raise SystemExit("Migration plan must contain a UUIDv7 migration_id")
    documents = payload.get("documents")
    if not isinstance(documents, list):
        raise SystemExit("Migration plan documents must be a list")
    return payload


def git_plan_commit(repo_root: Path, plan_rel: str) -> str:
    tracked = subprocess.run(
        ["git", "-C", str(repo_root), "ls-files", "--error-unmatch", "--", plan_rel],
        capture_output=True,
        text=True,
    )
    if tracked.returncode != 0:
        raise SystemExit("Migration plan must be committed before --write")
    for args in (["diff", "--quiet", "--", plan_rel], ["diff", "--cached", "--quiet", "--", plan_rel]):
        if subprocess.run(["git", "-C", str(repo_root), *args]).returncode != 0:
            raise SystemExit("Migration plan must be committed without staged or unstaged changes before --write")
    result = subprocess.run(
        ["git", "-C", str(repo_root), "log", "-1", "--format=%H", "--", plan_rel],
        check=True,
        capture_output=True,
        text=True,
    )
    commit = result.stdout.strip()
    if not commit:
        raise SystemExit("Migration plan must be committed before --write")
    return commit


def require_ancestor(repo_root: Path, ancestor: str, label: str) -> None:
    if not ancestor:
        raise SystemExit(f"Migration plan is missing {label}")
    result = subprocess.run(["git", "-C", str(repo_root), "merge-base", "--is-ancestor", ancestor, "HEAD"])
    if result.returncode != 0:
        raise SystemExit(f"Migration {label} {ancestor} is not an ancestor of HEAD")


def migration_receipt_valid(receipt_path: Path, migration_id: str, plan_sha256: str) -> bool:
    if not receipt_path.exists():
        return False
    try:
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid migration receipt JSON: {exc}") from exc
    if receipt.get("migration_id") != migration_id or receipt.get("plan_sha256") != plan_sha256:
        raise SystemExit(f"Migration receipt does not match plan: {receipt_path}")
    return True


def validate_migration_plan(
    plan: dict[str, object],
    repo_root: Path,
    root: Path,
    plan_rel: str,
    receipt_rel: str,
) -> None:
    if plan.get("document_format_from") != 1 or plan.get("document_format_to") != DOCUMENT_FORMAT_VERSION:
        raise SystemExit("Migration plan document-format transition is unsupported")
    excludes = plan.get("excludes", [])
    if not isinstance(excludes, list) or not all(isinstance(item, str) for item in excludes):
        raise SystemExit("Migration plan excludes must be a list of strings")
    if plan_rel == receipt_rel:
        raise SystemExit("Migration plan and receipt paths must be distinct")
    documents = plan["documents"]
    assert isinstance(documents, list)
    seen_paths: set[str] = set()
    seen_identities: dict[str, str] = {}
    planned_identities: dict[str, list[str]] = {}
    for entry in documents:
        if not isinstance(entry, dict):
            raise SystemExit("Migration plan document entries must be objects")
        path_value = entry.get("path")
        if not isinstance(path_value, str) or not path_value or Path(path_value).is_absolute():
            raise SystemExit("Migration plan document entry must use a repository-relative path")
        path, relative = repo_relative_path(path_value, repo_root)
        if relative != path_value or path.suffix != ".md":
            raise SystemExit(f"Migration plan document path is not a normalized Markdown path: {path_value}")
        try:
            path.relative_to(root.resolve())
        except ValueError as exc:
            raise SystemExit(f"Migration plan document is outside source_root: {path_value}") from exc
        if relative in {plan_rel, receipt_rel} or relative in seen_paths:
            raise SystemExit(f"Migration plan contains a duplicate or reserved document path: {path_value}")
        seen_paths.add(relative)
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"Migration plan document path is not a regular file: {path_value}")
        if not MIGRATION_SHA256_RE.fullmatch(str(entry.get("preimage_sha256", ""))):
            raise SystemExit(f"Migration plan has an invalid preimage hash for {path_value}")
        if not MIGRATION_SHA256_RE.fullmatch(str(entry.get("postimage_sha256", ""))):
            raise SystemExit(f"Migration plan has an invalid postimage hash for {path_value}")
        canonical_id = entry.get("uuid")
        aliases = entry.get("aliases")
        if not is_uuid7(canonical_id) or not isinstance(aliases, list):
            raise SystemExit(f"Migration plan has an invalid identity mapping for {path_value}")
        if not all(isinstance(alias, str) and alias.strip() == alias and alias for alias in aliases):
            raise SystemExit(f"Migration plan has an invalid alias for {path_value}")
        if len(aliases) != len(set(aliases)) or canonical_id in aliases:
            raise SystemExit(f"Migration plan has duplicate or self-referential aliases for {path_value}")
        identities = [str(canonical_id), *aliases]
        planned_identities[relative] = identities
        for identity in identities:
            previous = seen_identities.get(identity)
            if previous:
                raise SystemExit(f"Migration plan identity {identity} is ambiguous between {previous} and {path_value}")
            seen_identities[identity] = path_value

    corpus_paths: set[str] = set()
    final_lookup: dict[str, str] = {}
    for doc in format_docs(root, excludes):
        relative = doc.path.resolve().relative_to(repo_root).as_posix()
        corpus_paths.add(relative)
        if relative not in planned_identities:
            if doc.document_format_version == 1:
                raise SystemExit(f"Migration plan does not cover v1 document added after preparation: {relative}")
            identity_errors = validate_document_identity(doc)
            if identity_errors:
                raise SystemExit("Migration plan found an invalid unplanned document: " + "; ".join(identity_errors))
        identities = planned_identities.get(relative, doc.identity_keys)
        for identity in identities:
            previous = final_lookup.get(identity)
            if previous:
                raise SystemExit(f"Migration plan final identity {identity} is ambiguous between {previous} and {relative}")
            final_lookup[identity] = relative
    missing = sorted(seen_paths - corpus_paths)
    if missing:
        raise SystemExit("Migration plan includes documents outside the authored corpus: " + ", ".join(missing))


def migration_document_states(repo_root: Path, plan: dict[str, object]) -> list[dict[str, object]]:
    states: list[dict[str, object]] = []
    documents = plan["documents"]
    assert isinstance(documents, list)
    for entry in documents:
        if not isinstance(entry, dict):
            raise SystemExit("Migration plan document entries must be objects")
        path_value = entry.get("path")
        if not isinstance(path_value, str):
            raise SystemExit("Migration plan document entry is missing path")
        path, relative = repo_relative_path(path_value, repo_root)
        try:
            current = path.read_bytes()
        except FileNotFoundError as exc:
            raise SystemExit(f"UUID migration preimage conflict: missing {relative}") from exc
        current_hash = sha256_bytes(current)
        if current_hash == entry.get("preimage_sha256"):
            state = "preimage"
        elif current_hash == entry.get("postimage_sha256"):
            state = "postimage"
        else:
            state = "conflict"
        states.append({"path": relative, "absolute_path": path, "state": state, "current_sha256": current_hash, "entry": entry})
    return states


def apply_uuid_migration(root: Path, plan_value: str, write: bool) -> dict[str, object]:
    repo_root = git_repo_root(root)
    plan_path, plan_rel = repo_relative_path(plan_value, repo_root)
    plan_bytes = plan_path.read_bytes() if plan_path.exists() else b""
    plan = load_migration_plan(plan_path)
    plan_sha256 = sha256_bytes(plan_bytes)
    source_root = str(plan.get("source_root", "."))
    expected_root = (repo_root / source_root).resolve()
    if expected_root != root.resolve():
        raise SystemExit(f"Migration plan source_root {source_root!r} does not match --root {root}")
    receipt_value = plan.get("receipt_path")
    if not isinstance(receipt_value, str):
        raise SystemExit("Migration plan is missing receipt_path")
    receipt_path, receipt_rel = repo_relative_path(receipt_value, repo_root)
    validate_migration_plan(plan, repo_root, root, plan_rel, receipt_rel)
    states = migration_document_states(repo_root, plan)
    conflicts = [item for item in states if item["state"] == "conflict"]
    if conflicts:
        raise SystemExit("UUID migration preimage conflict: " + ", ".join(str(item["path"]) for item in conflicts))

    migration_id = str(plan["migration_id"])
    receipt_valid = migration_receipt_valid(receipt_path, migration_id, plan_sha256)
    remaining = sum(1 for item in states if item["state"] == "preimage")
    if remaining:
        state = "in_progress" if remaining < len(states) else "ready"
    else:
        state = "completed" if receipt_valid else "in_progress"

    if write:
        plan_commit = git_plan_commit(repo_root, plan_rel)
        require_ancestor(repo_root, plan_commit, "plan commit")
        require_ancestor(repo_root, str(plan.get("prepared_base_commit", "")), "prepared base commit")
        for item in states:
            if item["state"] != "preimage":
                continue
            entry = item["entry"]
            assert isinstance(entry, dict)
            path = item["absolute_path"]
            assert isinstance(path, Path)
            aliases = entry.get("aliases", [])
            if not isinstance(aliases, list) or not is_uuid7(entry.get("uuid")):
                raise SystemExit(f"Invalid identity mapping for {item['path']}")
            current = path.read_text(encoding="utf-8")
            postimage = migrate_document_text(current, str(entry["uuid"]), [str(alias) for alias in aliases]).encode("utf-8")
            if sha256_bytes(postimage) != entry.get("postimage_sha256"):
                raise SystemExit(f"Migration plan postimage mismatch for {item['path']}")
            atomic_write_bytes(path, postimage)

        plan_excludes = plan.get("excludes", [])
        assert isinstance(plan_excludes, list)
        migrated_docs = format_docs(root, [str(item) for item in plan_excludes])
        validation_errors = validate_identity_graph(migrated_docs)
        for doc in migrated_docs:
            validation_errors.extend(validate_document_identity(doc))
        if validation_errors:
            raise SystemExit("UUID migration validation failed before receipt: " + "; ".join(validation_errors))
        final_states = migration_document_states(repo_root, plan)
        if any(item["state"] != "postimage" for item in final_states):
            raise SystemExit("UUID migration did not reach all expected postimages")
        if not receipt_valid:
            receipt = {
                "schema_version": 1,
                "migration_type": DOCUMENT_MIGRATION_TYPE,
                "migration_id": migration_id,
                "plan_path": plan_rel,
                "plan_sha256": plan_sha256,
                "plan_commit": plan_commit,
                "applied_on_head": git_head(repo_root),
                "completed_at": dt.datetime.now().astimezone().isoformat(),
                "document_count": len(final_states),
            }
            atomic_write_bytes(receipt_path, (json.dumps(receipt, indent=2) + "\n").encode("utf-8"), refuse_existing=True)
        states = final_states
        state = "completed"

    return {
        "state": state,
        "migration_id": migration_id,
        "plan_path": plan_rel,
        "plan_sha256": plan_sha256,
        "receipt_path": receipt_rel,
        "documents": [{"path": item["path"], "state": item["state"]} for item in states],
    }


def next_id(family: str, docs: list[Doc], plan: str | None = None) -> str:
    if family == "impl":
        if not plan or not re.fullmatch(r"PLAN-\d{4}", plan):
            raise SystemExit("--plan PLAN-#### is required for impl IDs")
        plan_num = plan.split("-")[1]
        max_suffix = 0
        for doc in docs:
            for doc_id in doc.ids:
                match = re.fullmatch(rf"IMPL-{plan_num}-(\d{{2}})", doc_id)
                if match:
                    max_suffix = max(max_suffix, int(match.group(1)))
        return f"IMPL-{plan_num}-{max_suffix + 1:02d}"

    pattern = ID_PATTERNS[family]
    max_num = 0
    for doc in docs:
        for doc_id in doc.ids:
            match = pattern.fullmatch(doc_id)
            if match:
                max_num = max(max_num, int(match.group(1)))
    return f"{family.upper()}-{max_num + 1:04d}"


def yaml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def normalized_retirement_inputs(args: argparse.Namespace) -> tuple[str, str, str, str, str, str]:
    target_id = str(args.id).strip()
    plan = str(args.plan).strip()
    reason = str(args.reason).strip()
    source_type = str(args.source_type).strip()
    source_link = str(args.source_link).strip()
    source_notes = str(args.source_notes).strip()
    if not reason:
        raise SystemExit("--reason must be non-empty")
    if not source_type:
        raise SystemExit("--source-type must be non-empty")
    if not source_link and not source_notes:
        raise SystemExit("At least one non-empty --source-link or --source-notes is required")
    return target_id, plan, reason, source_type, source_link, source_notes


def safe_retirement_paths(root: Path, target_id: str, create_parent: bool = False) -> tuple[Path, Path, Path]:
    absolute_root = root.absolute()
    if absolute_root.is_symlink():
        raise SystemExit(f"Refusing symlinked docs root: {absolute_root}")
    if not absolute_root.exists():
        raise SystemExit(f"Docs root does not exist: {absolute_root}")
    if not absolute_root.is_dir():
        raise SystemExit(f"Docs root is not a directory: {absolute_root}")

    resolved_root = absolute_root.resolve()
    retirements_dir = resolved_root / "id-retirements"
    if retirements_dir.is_symlink():
        raise SystemExit(f"Refusing symlinked id-retirements component: {retirements_dir}")
    if retirements_dir.exists() and not retirements_dir.is_dir():
        raise SystemExit(f"Refusing id-retirements parent that is not a directory: {retirements_dir}")
    if create_parent and not retirements_dir.exists():
        try:
            retirements_dir.mkdir(mode=0o755)
        except FileExistsError:
            pass
    if retirements_dir.exists():
        if retirements_dir.is_symlink() or not retirements_dir.is_dir():
            raise SystemExit(f"Refusing unsafe id-retirements component: {retirements_dir}")
        if retirements_dir.resolve().parent != resolved_root:
            raise SystemExit(f"Refusing id-retirements path outside resolved docs root: {retirements_dir}")

    target = retirements_dir / f"{target_id}.md"
    if target.is_symlink():
        raise SystemExit(f"Refusing target symlink: {target}")
    if target.exists():
        mode = target.lstat().st_mode
        if not stat.S_ISREG(mode):
            raise SystemExit(f"Refusing tombstone target that is not a regular file: {target}")
    return resolved_root, retirements_dir, target


def retirement_stable_inputs(doc: Doc) -> tuple[str, str, str, str, str, str]:
    source = doc.frontmatter.get("source")
    source_map = source if isinstance(source, dict) else {}
    return (
        doc.primary_id.strip(),
        str(doc.frontmatter.get("parent_plan", "")).strip(),
        str(doc.frontmatter.get("reason", "")).strip(),
        str(source_map.get("type", "")).strip(),
        str(source_map.get("link", "")).strip(),
        str(source_map.get("notes", "")).strip(),
    )


def retirement_collisions(docs: list[Doc], target_id: str, expected_path: Path) -> list[str]:
    collisions: list[str] = []
    expected = expected_path.absolute()
    for doc in docs:
        if target_id not in doc.ids:
            continue
        if doc.path.absolute() == expected:
            continue
        collisions.append(doc.relpath)
    return collisions


def validate_retirement_request(
    docs: list[Doc],
    root: Path,
    target_path: Path,
    stable_inputs: tuple[str, str, str, str, str, str],
) -> str:
    target_id, plan, _, _, _, _ = stable_inputs
    impl_match = re.fullmatch(r"IMPL-(\d{4})-(\d{2})", target_id)
    if not impl_match:
        raise SystemExit("retire-id supports IMPL-####-## IDs only")
    if not re.fullmatch(r"PLAN-\d{4}", plan):
        raise SystemExit("--plan must use PLAN-####")
    parent = find_doc(docs, plan)
    if not parent or plan not in parent.identity_keys or parent.doc_type != "plan":
        raise SystemExit(f"--plan must reference a live primary plan document: {plan}")
    if impl_match.group(1) != plan.split("-")[1]:
        raise SystemExit(f"Target ID {target_id} does not match --plan {plan}")

    collisions = retirement_collisions(docs, target_id, target_path)
    if collisions:
        raise SystemExit(f"Retirement collision for {target_id}: {', '.join(collisions)}")

    existing_doc = next((doc for doc in docs if doc.path.absolute() == target_path.absolute()), None)
    if target_path.exists():
        if existing_doc and existing_doc.is_id_retirement:
            validation_errors = validate_frontmatter(existing_doc, docs)
            if validation_errors:
                detail = "; ".join(validation_errors)
                raise SystemExit(f"Existing tombstone at {target_path} is invalid: {detail}")
            if retirement_stable_inputs(existing_doc) == stable_inputs:
                return "existing"
        raise SystemExit(f"Existing tombstone at {target_path} conflicts with the requested retirement")

    current_next = next_id("impl", docs, plan)
    if target_id != current_next:
        raise SystemExit(f"Target must equal the current next IMPL ID for {plan}: {current_next}")
    return "new"


def retirement_doc(stable_inputs: tuple[str, str, str, str, str, str], timestamp: str, commit: str) -> str:
    target_id, plan, reason, source_type, source_link, source_notes = stable_inputs
    return f"""---
type: id-retirement
id: {target_id}
title: Retired ID {target_id}
status: retired
parent_plan: {plan}
reason: {yaml_string(reason)}
source:
  type: {yaml_string(source_type)}
  link: {yaml_string(source_link)}
  notes: {yaml_string(source_notes)}
created_at: {yaml_string(timestamp)}
updated_at: {yaml_string(timestamp)}
orphan_ok: true
{repo_state_yaml(commit)}
---

# Retired ID {target_id}

This ID is permanently retired. Agent Continuity will count it for allocation
and the global docs registry, but it is not live implementation work.
"""


def exclusive_publish_retirement(
    retirements_dir: Path,
    target: Path,
    content: bytes,
    final_validate,
) -> None:
    open_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    directory_fd = os.open(retirements_dir, open_flags)
    temp_name = ""
    temp_fd = -1
    try:
        directory_stat = os.fstat(directory_fd)
        path_stat = os.stat(retirements_dir, follow_symlinks=False)
        if (directory_stat.st_dev, directory_stat.st_ino) != (path_stat.st_dev, path_stat.st_ino):
            raise SystemExit("id-retirements changed during publication")
        for _ in range(20):
            candidate = f".{target.stem}.{secrets.token_hex(8)}.tmp"
            try:
                temp_fd = os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                    0o644,
                    dir_fd=directory_fd,
                )
                temp_name = candidate
                break
            except FileExistsError:
                continue
        if temp_fd < 0:
            raise SystemExit("Could not allocate an exclusive tombstone staging file")
        view = memoryview(content)
        while view:
            written = os.write(temp_fd, view)
            view = view[written:]
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = -1

        final_validate()
        current_stat = os.stat(retirements_dir, follow_symlinks=False)
        if (directory_stat.st_dev, directory_stat.st_ino) != (current_stat.st_dev, current_stat.st_ino):
            raise SystemExit("id-retirements changed during final validation")
        try:
            os.link(
                temp_name,
                target.name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except OSError as exc:
            if exc.errno == errno.EEXIST:
                raise SystemExit(f"Tombstone target appeared during publication; nothing was overwritten: {target}")
            raise
        os.unlink(temp_name, dir_fd=directory_fd)
        temp_name = ""
        os.fsync(directory_fd)
    finally:
        if temp_fd >= 0:
            os.close(temp_fd)
        if temp_name:
            try:
                os.unlink(temp_name, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
        os.close(directory_fd)


def retire_id(args: argparse.Namespace, root: Path) -> int:
    stable_inputs = normalized_retirement_inputs(args)
    target_id = stable_inputs[0]
    resolved_root, _, target = safe_retirement_paths(root, target_id)
    docs = read_docs(resolved_root)
    state = validate_retirement_request(docs, resolved_root, target, stable_inputs)
    if state == "existing":
        print(f"ALREADY RETIRED\t{target}")
        return 0

    body = v2_document_body(retirement_doc(stable_inputs, now_string(), git_head()), target_id)
    if not args.write:
        print(f"PREVIEW\t{target}")
        print(body, end="")
        print("Re-run with --write to publish this tombstone.")
        return 0

    resolved_root, retirements_dir, target = safe_retirement_paths(root, target_id, create_parent=True)

    def final_validate() -> None:
        fresh_root, fresh_dir, fresh_target = safe_retirement_paths(root, target_id)
        if fresh_root != resolved_root or fresh_dir != retirements_dir or fresh_target != target:
            raise SystemExit("Retirement path changed during final validation")
        fresh_docs = read_docs(fresh_root)
        if validate_retirement_request(fresh_docs, fresh_root, fresh_target, stable_inputs) != "new":
            raise SystemExit("Retirement target changed during final validation")

    exclusive_publish_retirement(retirements_dir, target, body.encode("utf-8"), final_validate)
    print(f"RETIRED\t{target}")
    return 0


def next_todo_id(docs: list[Doc]) -> str:
    max_num = 0
    for item in todo_items(docs, include_done=True):
        if not item.todo_id:
            continue
        match = TODO_ID_RE.fullmatch(item.todo_id)
        if match:
            max_num = max(max_num, int(match.group(1)))
    return f"TODO-{max_num + 1:04d}"


def live_docs(docs: list[Doc]) -> list[Doc]:
    return [doc for doc in docs if not doc.is_id_retirement]


def find_any_doc(docs: list[Doc], doc_id: str) -> Doc | None:
    matches = [doc for doc in docs if doc_id in doc.identity_keys]
    if len(matches) > 1:
        paths = ", ".join(doc.relpath for doc in matches)
        raise SystemExit(f"Ambiguous document identity or alias {doc_id}: {paths}")
    return matches[0] if matches else None


def find_doc(docs: list[Doc], doc_id: str) -> Doc | None:
    doc = find_any_doc(docs, doc_id)
    return None if doc and doc.is_id_retirement else doc


def as_string_list(value: object) -> list[str]:
    if isinstance(value, list):
        return [str(item).strip() for item in value if str(item).strip()]
    if isinstance(value, str) and value.strip():
        return [value.strip()]
    return []


def linked_path_info(raw: str, root: Path) -> dict[str, str]:
    repo_root = repo_root_for(root)
    candidate = Path(raw)
    resolved = candidate.resolve() if candidate.is_absolute() else (repo_root / candidate).resolve()
    try:
        rel_repo = resolved.relative_to(repo_root.resolve()).as_posix()
    except ValueError:
        return {"input": raw, "path": resolved.as_posix(), "status": "outside-repo"}
    return {"input": raw, "path": rel_repo, "status": "ok" if resolved.exists() else "missing"}


def relation_summary(doc: Doc, docs: list[Doc]) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    keys = ["parent_plan"] + sorted(
        key
        for key in doc.frontmatter
        if key.startswith("related_") or key in {"supersedes", "superseded_by", "promoted_to", "resolved_by"}
    )
    seen: set[tuple[str, str]] = set()
    for key in keys:
        for value in as_string_list(doc.frontmatter.get(key)):
            pair = (key, value)
            if pair in seen:
                continue
            seen.add(pair)
            target = find_doc(docs, value)
            rows.append(
                {
                    "field": key,
                    "id": value,
                    "path": target.relpath if target else "",
                    "status": target.status if target else "",
                    "title": target.title if target else "",
                }
            )
    return rows


def show_doc(doc: Doc, docs: list[Doc], root: Path) -> dict[str, object]:
    return {
        "id": doc.canonical_id,
        "display_id": doc.primary_id,
        "aliases": doc.aliases,
        "document_format_version": doc.document_format_version,
        "type": doc.doc_type,
        "title": doc.title,
        "status": doc.status,
        "path": doc.relpath,
        "relations": relation_summary(doc, docs),
        "linked_paths": [linked_path_info(path, root) for path in as_string_list(doc.frontmatter.get("linked_paths"))],
        "todos": [item.as_dict() for item in todo_items_for_doc(doc, include_done=True)],
    }


def show_doc_text(payload: dict[str, object]) -> str:
    lines = [
        f"ID:\t{payload.get('id', '')}",
        f"Display ID:\t{payload.get('display_id', '')}",
        f"Aliases:\t{', '.join(str(item) for item in payload.get('aliases', []))}",
        f"Type:\t{payload.get('type', '')}",
        f"Title:\t{payload.get('title', '')}",
        f"Status:\t{payload.get('status', '')}",
        f"Path:\t{payload.get('path', '')}",
        "",
        "Relations:",
    ]
    relations = payload.get("relations", [])
    if isinstance(relations, list) and relations:
        for item in relations:
            if not isinstance(item, dict):
                continue
            suffix = f" -> {item.get('path', '')}" if item.get("path") else ""
            title = f" ({item.get('title', '')})" if item.get("title") else ""
            lines.append(f"- {item.get('field', '')}: {item.get('id', '')}{suffix}{title}")
    else:
        lines.append("- none")
    lines.extend(["", "Linked Paths:"])
    linked_paths = payload.get("linked_paths", [])
    if isinstance(linked_paths, list) and linked_paths:
        for item in linked_paths:
            if not isinstance(item, dict):
                continue
            lines.append(f"- {item.get('input', '')}: {item.get('status', '')} -> {item.get('path', '')}")
    else:
        lines.append("- none")
    lines.extend(["", "Todos:"])
    todos = payload.get("todos", [])
    if isinstance(todos, list) and todos:
        for item in todos:
            if not isinstance(item, dict):
                continue
            todo_id = item.get("id", "")
            prefix = f"{todo_id} " if todo_id else ""
            status = item.get("status", item.get("state", ""))
            lines.append(f"- {prefix}[{status}] {item.get('task', '')}")
    else:
        lines.append("- none")
    return "\n".join(lines)


def v2_document_body(body: str, generated_id: str) -> str:
    canonical_id = generated_id if is_uuid7(generated_id) else new_uuid7()
    marker = f"id: {generated_id}\n"
    if marker not in body:
        raise SystemExit(f"Generated document is missing expected identity field: {generated_id}")
    aliases = f"aliases:\n  - {generated_id}\n" if not is_uuid7(generated_id) else "aliases: []\n"
    body = body.replace(
        marker,
        f"document_format_version: {DOCUMENT_FORMAT_VERSION}\nid: {canonical_id}\n{aliases}",
        1,
    )
    body = re.sub(rf"^#\s+{re.escape(generated_id)}\s+-\s+", "# ", body, count=1, flags=re.MULTILINE)
    return body


def new_doc(args: argparse.Namespace, root: Path, docs: list[Doc]) -> Path:
    title = args.title
    slug = slugify(title)
    timestamp = now_string()
    commit = git_head()
    doc_id = new_uuid7()

    if args.family == "idea":
        path = root / args.domain / "ideas" / f"IDEA-{slug}.md"
        body = idea_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"research", "rsch"}:
        path = root / "research" / f"RSCH-{slug}.md"
        body = research_survey_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"eval", "evaluation"}:
        path = root / "repo-health" / "evaluations" / f"EVAL-{slug}.md"
        body = evaluation_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"diag", "diagnostic"}:
        path = root / "repo-health" / "debugging" / "diagnostics" / f"DIAG-{slug}.md"
        body = diagnostic_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"concept", "conc"}:
        path = root / args.domain / "concepts" / f"CONC-{slug}.md"
        body = concept_doc(doc_id, title, args, timestamp, commit)
    elif args.family == "audit":
        if not args.audit_kind:
            raise SystemExit("--kind is required for audit docs")
        path = root / "repo-health" / "audits" / f"AUDT-{slug}.md"
        body = audit_doc(doc_id, title, args, timestamp, commit)
    elif args.family == "spec":
        path = root / args.domain / "specs" / f"SPEC-{slug}.md"
        body = spec_doc(doc_id, title, args, timestamp, commit)
    elif args.family == "plan":
        path = root / args.domain / "plans" / f"PLAN-{slug}" / f"PLAN-{slug}.md"
        body = plan_doc(doc_id, title, args, timestamp, commit)
    elif args.family == "impl":
        if not args.plan:
            raise SystemExit("--plan <plan UUID or legacy alias> is required for impl docs")
        parent = find_doc(docs, args.plan)
        if not parent or parent.doc_type != "plan":
            raise SystemExit(f"--plan must reference a live primary plan document: {args.plan}")
        base = parent.path.parent if parent else root / args.domain / "plans" / args.plan
        path = base / f"IMPL-{slug}.md"
        body = impl_doc(doc_id, title, args, timestamp, commit)
    elif args.family == "adr":
        path = root / "decisions" / "adr" / f"ADR-{slug}.md"
        body = adr_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"learning", "lrn"}:
        path = root / "decisions" / "learnings" / f"LRN-{slug}.md"
        body = learning_doc(doc_id, title, args, timestamp, commit)
    elif args.family in {"explainer", "expl"}:
        path = root / "orientation" / "explainers" / f"EXPL-{slug}.md"
        body = explainer_doc(doc_id, title, args, timestamp, commit)
    else:
        path = root / "decisions" / "questions" / f"QST-{slug}.md"
        body = question_doc(doc_id, title, args, timestamp, commit)

    body = v2_document_body(body, doc_id)
    if path.exists():
        raise SystemExit(f"Refusing to overwrite existing file: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body, encoding="utf-8")
    return path


def status_for_new(args: argparse.Namespace, doc_type: str) -> str:
    status = args.status
    if doc_type == "adr" and status == "draft":
        status = "proposed"
    if doc_type == "idea" and status == "draft":
        status = "captured"
    if doc_type == "learning" and status == "draft":
        status = "active"
    if doc_type == "question" and status == "draft":
        status = "open"
    if doc_type == "diagnostic-record" and status == "draft":
        status = "investigating"
    if doc_type == "repo-health-audit" and status == "draft":
        status = "planned"
    allowed = STATUS_BY_TYPE.get(doc_type, COMMON_STATUSES)
    if status not in allowed:
        raise SystemExit(f"Status {status!r} is not valid for {doc_type}; choose one of: {', '.join(sorted(allowed))}")
    return status


def yaml_list(values: list[str]) -> str:
    if not values:
        return "[]"
    return "\n" + "\n".join(f"  - {value}" for value in values)


def repo_state_yaml(commit: str) -> str:
    return f"""repo_state:
  based_on_commit: {commit}
  last_reviewed_commit: {commit}"""


def idea_doc(doc_id: str, title: str, args: argparse.Namespace, timestamp: str, commit: str) -> str:
