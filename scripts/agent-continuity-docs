def todos_markdown(docs: list[Doc]) -> str:
    items = todo_items(docs)
    structured = [item for item in items if item.structured]
    local = [item for item in items if not item.structured]
    lines = [
        "# Docs Todos",
        "",
        GENERATED_HEADER,
        "",
        "Generated dashboard for Markdown todos. Source docs are canonical; edit the source checkbox line, then regenerate this view.",
        "",
        "## Structured Todos",
        "",
    ]
    if structured:
        lines.extend(
            [
                "| ID | Status | Owner | Agent | Updated | Skill | Source | Path | Line | Plan | Brief | Task |",
                "|---|---|---|---|---|---|---|---|---:|---|---|---|",
            ]
        )
        for item in structured:
            lines.append(
                "| {id} | {status} | {owner} | {agent} | {updated} | {skill} | {source} | {path} | {line} | {plan} | {brief} | {task} |".format(
                    id=markdown_table_cell(item.todo_id),
                    status=markdown_table_cell(item.status),
                    owner=markdown_table_cell(item.owner),
                    agent=markdown_table_cell(item.agent),
                    updated=markdown_table_cell(item.metadata.get("updated", "")),
                    skill=markdown_table_cell(item.skill),
                    source=markdown_table_cell(item.source),
                    path=markdown_table_cell(f"`{item.path}`"),
                    line=item.line,
                    plan=markdown_table_cell(item.plan),
                    brief=markdown_table_cell(item.brief),
                    task=markdown_table_cell(item.task),
                )
            )
    else:
        lines.append("No structured `TODO-*` items found.")
    lines.extend(
        [
            "",
            "## Local Checkboxes",
            "",
        ]
    )
    if local:
        lines.extend(
            [
                "| State | Source | Line | Task |",
                "|---|---|---:|---|",
            ]
        )
        for item in local:
            lines.append(
                "| {state} | {source} | {line} | {task} |".format(
                    state=markdown_table_cell(item.state),
                    source=markdown_table_cell(item.source),
                    line=item.line,
                    task=markdown_table_cell(item.task),
                )
            )
    else:
        lines.append("No local checkbox todos found.")
    lines.append("")
    return generated_view("generated-view", "Docs Todos", lines)


def areas_markdown(docs: list[Doc]) -> str:
    areas = sorted((doc for doc in live_docs(docs) if doc.doc_type == "architecture-area"), key=lambda d: d.primary_id or d.title)
    lines = [
        "# Architecture Area Registry",
        "",
        GENERATED_HEADER,
        "",
        "| ID | Title | Status | Path |",
        "|---|---|---|---|",
    ]
    for doc in areas:
        lines.append(f"| {doc.primary_id} | {doc.title} | {doc.status} | `{doc.relpath}` |")
    lines.append("")
    return generated_view("generated-view", "Architecture Area Registry", lines)


def audit_docs(docs: list[Doc]) -> list[Doc]:
    return sorted((doc for doc in live_docs(docs) if doc.doc_type == "repo-health-audit"), key=lambda d: d.frontmatter.get("audit_ended_at") or d.frontmatter.get("created_at") or d.relpath, reverse=True)


def audits_markdown(docs: list[Doc]) -> str:
    audits = audit_docs(docs)
    lines = [
        "# Repo Health Audits",
        "",
        GENERATED_HEADER,
        "",
        "Generated index of repo-health audits. Audits are periodic receipts for docs, architecture, maintenance, duplication/refactor, tests, tooling, and other project hygiene checks.",
        "",
        "| ID | Date | Kind | Status | Title | Scope | Path |",
        "|---|---|---|---|---|---|---|",
    ]
    for doc in audits:
        ended_at = doc.frontmatter.get("audit_ended_at") or doc.frontmatter.get("created_at", "")
        date = str(ended_at).split(" ", 1)[0] if ended_at else ""
        lines.append(f"| {doc.primary_id} | {date} | {doc.frontmatter.get('audit_kind', '')} | {doc.status} | {doc.title} | {field_summary(doc.frontmatter.get('scope', ''))} | `{doc.relpath}` |")
    lines.append("")
    return generated_view("generated-view", "Repo Health Audits", lines)


def sequence_value(doc: Doc) -> str:
    sequence = doc.frontmatter.get("sequence")
    if isinstance(sequence, dict):
        value = sequence.get("roadmap") or sequence.get("sort_key")
        return str(value) if value else ""
    value = doc.frontmatter.get("roadmap_sequence")
    return str(value) if value else ""


def sort_sequence(value: str) -> tuple:
    if not value:
        return ((1, "zzzzzz"),)
    parts: list[tuple[int, object]] = []
    for part in re.split(r"([0-9]+)", value):
        if part == "":
            continue
        if part.isdigit():
            parts.append((0, int(part)))
        else:
            parts.append((1, part.lower()))
    return tuple(parts)


def roadmap_rows(docs: list[Doc]) -> list[dict[str, str]]:
    plans = sorted((doc for doc in live_docs(docs) if doc.doc_type == "plan"), key=lambda d: (sort_sequence(sequence_value(d)), d.primary_id))
    rows: list[dict[str, str]] = []
    for doc in plans:
        sequence = doc.frontmatter.get("sequence")
        after = before = lane = ""
        if isinstance(sequence, dict):
            after = field_summary(sequence.get("after", ""))
            before = field_summary(sequence.get("before", ""))
            lane = str(sequence.get("lane", "") or "")
        plan_name = doc.path.stem
        rows.append(
            {
                "sequence": sequence_value(doc),
                "id": doc.primary_id,
                "plan_name": plan_name,
                "title": doc.title,
                "status": doc.status,
                "domain": str(doc.frontmatter.get("domain", "")),
                "lane": lane,
                "after": after,
                "before": before,
                "path": doc.relpath,
            }
        )
    return rows


def roadmap_markdown(docs: list[Doc]) -> str:
    rows = roadmap_rows(docs)
    lines = [
        "# Roadmap View",
        "",
        GENERATED_HEADER,
        "",
        "Generated plan-order view. `PLAN-*` numbering and `sequence` frontmatter should agree; if execution order changes before implementation, move/renumber the docs instead of relying on hidden dependencies.",
        "",
        "| Sequence | Plan | Plan Name | Title | Status | Domain | Lane | After | Before | Path |",
        "|---|---|---|---|---|---|---|---|---|---|",
    ]
    for row in rows:
        lines.append(
            "| {sequence} | {id} | {plan_name} | {title} | {status} | {domain} | {lane} | {after} | {before} | `{path}` |".format(**row)
        )
    if not rows:
        lines.append("|  |  |  | No plans found. |  |  |  |  |  |  |")
    lines.append("")
    return generated_view("generated-view", "Roadmap View", lines)


def parse_timestamp(value: object) -> dt.datetime | None:
    if not isinstance(value, str) or not value:
        return None
    match = re.search(r"(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})(?: [A-Za-z0-9_+/-]+)? ([+-]\d{4})", value)
    if match:
        try:
            return dt.datetime.strptime(f"{match.group(1)} {match.group(2)}", "%Y-%m-%d %H:%M:%S %z")
        except ValueError:
            return None
    try:
        parsed = dt.datetime.fromisoformat(value)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.datetime.now().astimezone().tzinfo)
        return parsed
    except ValueError:
        return None


def nested_value(mapping: dict[str, object], key: str, child_key: str) -> str:
    value = mapping.get(key)
    if isinstance(value, dict):
        child = value.get(child_key)
        return child if isinstance(child, str) else ""
    return ""


def health_issues(root: Path, docs: list[Doc], stale_days: int, commit_threshold: int, audit_days: int) -> list[HealthIssue]:
    issues: list[HealthIssue] = []
    now = dt.datetime.now().astimezone()
    current_head = git_head()
    freshness_types = {
        "current-state",
        "onboarding",
        "roadmap",
        "architecture-overview",
        "architecture-area",
        "codebase-map",
        "data-seams",
        "testing-guide",
    }
    work_statuses = {"captured", "exploring", "draft", "proposed", "ready", "in_progress", "in-progress", "blocked"}
    archived_statuses = {"archived", "rejected", "superseded"}
    audits = audit_docs(docs)
    completed_audits = [doc for doc in audits if doc.status == "completed"]
    if not completed_audits:
        issues.append(
            HealthIssue(
                "info",
                "missing-repo-health-audit",
                "repo-health/audits/",
                "No completed repo-health audit found.",
                "Create one after periodic docs, architecture, maintenance, tests, and tooling checks.",
            )
        )
    else:
        last_audit = completed_audits[0]
        audit_time = parse_timestamp(last_audit.frontmatter.get("audit_ended_at") or last_audit.frontmatter.get("updated_at"))
        if audit_time:
            audit_age = (now - audit_time).days
            if audit_age >= audit_days:
                issues.append(
                    HealthIssue(
                        "warn",
                        "repo-health-audit-due",
                        last_audit.relpath,
                        f"Last completed repo-health audit was {audit_age} days ago.",
                        f"Threshold: {audit_days} days",
                    )
                )

    for doc in docs:
        doc_type = doc.doc_type
        if not doc_type or doc.status in archived_statuses:
            continue

        updated_at = parse_timestamp(doc.frontmatter.get("updated_at"))
        age_days = (now - updated_at).days if updated_at else None
        label = doc.primary_id or doc.relpath

        if doc_type in freshness_types:
            if age_days is None:
                issues.append(HealthIssue("warn", "missing-updated-at", doc.relpath, f"{label} has no parseable updated_at timestamp."))
            elif age_days >= stale_days:
                issues.append(
                    HealthIssue(
                        "warn",
                        "stale-by-time",
                        doc.relpath,
                        f"{label} has not been updated in {age_days} days.",
                        f"Threshold: {stale_days} days",
                    )
                )

        if doc.status in work_statuses and age_days is not None and age_days >= stale_days:
            severity = "warn" if doc.status == "blocked" else "info"
            issues.append(
                HealthIssue(
                    severity,
                    "open-work-aging",
                    doc.relpath,
                    f"{label} is {doc.status} and has not been updated in {age_days} days.",
                    f"Review whether the status still reflects reality.",
                )
            )

        reviewed_commit = nested_value(doc.frontmatter, "repo_state", "last_reviewed_commit")
        if "repo_state" in doc.frontmatter and not reviewed_commit:
            issues.append(HealthIssue("info", "missing-review-commit", doc.relpath, f"{label} has repo_state but no last_reviewed_commit."))
        elif reviewed_commit and current_head and reviewed_commit != current_head:
            count = git_commit_count_since(reviewed_commit)
            if count is not None and count >= commit_threshold:
                issues.append(
                    HealthIssue(
                        "warn",
                        "stale-by-commit",
                        doc.relpath,
                        f"{label} was last reviewed {count} commits ago.",
                        f"last_reviewed_commit: {reviewed_commit}",
                    )
                )

    refs = link_graph(root, docs)
    for ref in broken_link_refs(refs):
        issues.append(
            HealthIssue(
                "warn",
                "broken-link",
                ref.source_rel,
                f"{ref.source_rel}:{ref.line} links to {ref.href!r}, which is {ref.status}.",
                ref.detail,
            )
        )
    for ref in refs:
        if ref.status in {"absolute-repo-local", "root-relative"}:
            issues.append(
                HealthIssue(
                    "info",
                    "non-relative-link",
                    ref.source_rel,
                    f"{ref.source_rel}:{ref.line} uses a {ref.status} repo-local href.",
                    ref.href,
                )
            )
    for doc in orphan_docs(root, docs, refs):
        issues.append(
            HealthIssue(
                "info",
                "orphan-doc",
                doc.relpath,
                f"{doc.primary_id or doc.relpath} has no inbound Markdown links.",
                "Review whether this is intentional or add an index/backlink.",
            )
        )

    return issues


def health_markdown(issues: list[HealthIssue], stale_days: int, commit_threshold: int, audit_days: int) -> str:
    lines = [
        "# Docs Health",
        "",
        GENERATED_HEADER,
        "",
        "Advisory review queue for docs that may be stale or worth checking. This is not a correctness report; use `agent-continuity docs check` for deterministic validation.",
        "",
        f"- Time threshold: {stale_days} days",
        f"- Commit threshold: {commit_threshold} commits since `repo_state.last_reviewed_commit`",
        f"- Audit threshold: {audit_days} days since last completed repo-health audit",
        "",
        "| Severity | Code | Doc | Message | Detail |",
        "|---|---|---|---|---|",
    ]
    for issue in issues:
        lines.append(f"| {issue.severity} | {issue.code} | `{issue.doc}` | {issue.message} | {issue.detail} |")
    if not issues:
        lines.append("| ok | none |  | No docs health issues found. |  |")
    lines.append("")
    return generated_view("generated-view", "Docs Health", lines)


def health_text(issues: list[HealthIssue]) -> str:
    if not issues:
        return "No docs health issues found."
    return "\n".join(
        f"{issue.severity.upper()}\t{issue.code}\t{issue.doc}\t{issue.message}" + (f"\t{issue.detail}" if issue.detail else "")
        for issue in issues
    )


def generated_view_path(root: Path, name: str) -> Path:
    paths = {
        "ideas": root / "IDEAS.md",
        "concepts": root / "CONCEPTS.md",
        "specs": root / "SPECS.md",
        "learnings": root / "LEARNINGS.md",
        "explainers": root / "EXPLAINERS.md",
        "questions": root / "QUESTIONS.md",
        "registry": root / "DOCS-REGISTRY.md",
        "todos": root / "TODOS.md",
        "areas": root / "AREAS.md",
        "audits": root / "AUDITS.md",
        "roadmap": root / "ROADMAP-VIEW.md",
        "health": root / "HEALTH.md",
    }
    return paths[name]


def generated_view_markdown(root: Path, name: str, docs: list[Doc], args: argparse.Namespace | None = None) -> str:
    if name == "ideas":
        return ideas_markdown(docs)
    if name == "concepts":
        return concepts_markdown(docs)
    if name == "specs":
        return specs_markdown(docs)
    if name == "learnings":
        return learnings_markdown(docs)
    if name == "explainers":
        return explainers_markdown(docs)
    if name == "questions":
        return questions_markdown(docs)
    if name == "registry":
        return registry_markdown(docs)
    if name == "todos":
        return todos_markdown(docs)
    if name == "areas":
        return areas_markdown(docs)
    if name == "audits":
        return audits_markdown(docs)
    if name == "roadmap":
        return roadmap_markdown(docs)
    if name == "health":
        stale_days = getattr(args, "stale_days", 14)
        commit_threshold = getattr(args, "commit_threshold", 10)
        audit_days = getattr(args, "audit_days", 30)
        issues = health_issues(root, docs, stale_days, commit_threshold, audit_days)
        return health_markdown(issues, stale_days, commit_threshold, audit_days)
    raise SystemExit(f"Unknown generated view: {name}")


def write_generated_view(root: Path, name: str, docs: list[Doc], args: argparse.Namespace | None = None) -> str:
    markdown = generated_view_markdown(root, name, docs, args)
    generated_view_path(root, name).write_text(markdown, encoding="utf-8")
    return markdown


def update(root: Path, docs: list[Doc]) -> None:
    if any(doc.doc_type == "idea" for doc in docs) or (root / "IDEAS.md").exists():
        write_generated_view(root, "ideas", docs)
    if any(doc.doc_type == "concept" for doc in docs) or (root / "CONCEPTS.md").exists():
        write_generated_view(root, "concepts", docs)
    if any(doc.doc_type == "learning" for doc in docs) or (root / "LEARNINGS.md").exists():
        write_generated_view(root, "learnings", docs)
    if any(doc.doc_type == "explainer" for doc in docs) or (root / "EXPLAINERS.md").exists():
        write_generated_view(root, "explainers", docs)
    if any(doc.doc_type == "question" for doc in docs) or (root / "QUESTIONS.md").exists():
        write_generated_view(root, "questions", docs)
    write_generated_view(root, "specs", docs)
    write_generated_view(root, "registry", docs)
    write_generated_view(root, "todos", docs)
    if any(doc.doc_type == "repo-health-audit" for doc in docs) or (root / "AUDITS.md").exists():
        write_generated_view(root, "audits", docs)
    if any(doc.doc_type == "plan" for doc in docs) or (root / "ROADMAP-VIEW.md").exists():
        write_generated_view(root, "roadmap", docs)
    if any(doc.doc_type == "architecture-area" for doc in docs) or (root / "AREAS.md").exists():
        write_generated_view(root, "areas", docs)


def check(root: Path, docs: list[Doc]) -> int:
    errors: list[str] = validate_identity_graph(docs)
    seen: dict[str, str] = {}
    for doc in docs:
        doc_id = doc.primary_id
        if doc.relpath.startswith("id-retirements/") and doc.doc_type != "id-retirement":
            errors.append(f"Document in id-retirements must use type 'id-retirement': {doc.relpath}")
        if not doc_id:
            if doc.doc_type:
                errors.extend(validate_frontmatter(doc, docs))
                errors.extend(validate_linked_paths(doc, root))
            continue
        if doc.document_format_version == 1 and doc_id in seen:
            errors.append(f"Duplicate ID {doc_id}: {seen[doc_id]} and {doc.relpath}")
        seen[doc_id] = doc.relpath
        if doc.document_format_version == 1 and doc_id not in doc.path.name:
            errors.append(f"ID {doc_id} is not present in filename: {doc.relpath}")
        errors.extend(validate_frontmatter(doc, docs))
        errors.extend(validate_linked_paths(doc, root))

    for doc in docs:
        if not doc.is_id_retirement:
            continue
        retired_id = doc.primary_id
        if not retired_id:
            continue
        for collision in retirement_collisions(docs, retired_id, doc.path):
            errors.append(f"Retirement collision for {retired_id}: {doc.relpath} and {collision}")

    generated = {
        root / "SPECS.md": specs_markdown(docs),
        root / "DOCS-REGISTRY.md": registry_markdown(docs),
        root / "TODOS.md": todos_markdown(docs),
    }
    if any(doc.doc_type == "idea" for doc in docs) or (root / "IDEAS.md").exists():
        generated[root / "IDEAS.md"] = ideas_markdown(docs)
    if any(doc.doc_type == "concept" for doc in docs) or (root / "CONCEPTS.md").exists():
        generated[root / "CONCEPTS.md"] = concepts_markdown(docs)
    if any(doc.doc_type == "learning" for doc in docs) or (root / "LEARNINGS.md").exists():
        generated[root / "LEARNINGS.md"] = learnings_markdown(docs)
    if any(doc.doc_type == "explainer" for doc in docs) or (root / "EXPLAINERS.md").exists():
        generated[root / "EXPLAINERS.md"] = explainers_markdown(docs)
    if any(doc.doc_type == "question" for doc in docs) or (root / "QUESTIONS.md").exists():
        generated[root / "QUESTIONS.md"] = questions_markdown(docs)
    if any(doc.doc_type == "repo-health-audit" for doc in docs) or (root / "AUDITS.md").exists():
        generated[root / "AUDITS.md"] = audits_markdown(docs)
    if any(doc.doc_type == "plan" for doc in docs) or (root / "ROADMAP-VIEW.md").exists():
        generated[root / "ROADMAP-VIEW.md"] = roadmap_markdown(docs)
    if any(doc.doc_type == "architecture-area" for doc in docs) or (root / "AREAS.md").exists():
        generated[root / "AREAS.md"] = areas_markdown(docs)
    for path, expected in generated.items():
        if path.exists() and normalize_generated_view(path.read_text(encoding="utf-8")) != normalize_generated_view(expected):
            errors.append(f"Generated file is stale: {path.relative_to(root)}")

    for error in errors:
        print(f"ERROR: {error}", file=sys.stderr)
    return 1 if errors else 0


def todo_validation_issues(docs: list[Doc], strict: bool = False) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    items = todo_items(docs, include_done=True)
    structured = [item for item in items if item.structured]
    by_id: dict[str, TodoItem] = {}
    live_by_id = {
        identity: doc
        for doc in live_docs(docs)
        for identity in doc.identity_keys
    }

    for item in structured:
        where = f"{item.path}:{item.line}"
        if item.todo_id in by_id:
            previous = by_id[item.todo_id]
            errors.append(f"Duplicate todo ID {item.todo_id}: {previous.path}:{previous.line} and {where}")
        else:
            by_id[item.todo_id] = item
        if item.status not in TODO_STATUSES:
            errors.append(f"{where} has invalid todo status {item.status!r} for {item.todo_id}")
        if item.state == "done" and item.status in TODO_ACTIVE_STATUSES:
            errors.append(f"{where} has checked checkbox but active status {item.status!r} for {item.todo_id}")
        if item.state == "open" and item.status == "done":
            errors.append(f"{where} has open checkbox but done status for {item.todo_id}")
        if item.status == "in_progress":
            if not item.owner:
                errors.append(f"{where} has in_progress status without owner for {item.todo_id}")
            if not item.agent:
                errors.append(f"{where} has in_progress status without agent for {item.todo_id}")
            if not item.metadata.get("updated"):
                errors.append(f"{where} has in_progress status without updated timestamp for {item.todo_id}")
        if item.status == "review" and not item.metadata.get("updated"):
            errors.append(f"{where} has review status without updated timestamp for {item.todo_id}")
        if item.status == "blocked" and not any(item.metadata.get(key) for key in ("blocker", "blocked_by", "reason")):
            errors.append(f"{where} has blocked status without blocker, blocked_by, or reason for {item.todo_id}")
        if item.status == "done" and not any(item.metadata.get(key) for key in ("verification", "evidence", "reason")):
            errors.append(f"{where} has done status without verification, evidence, or reason for {item.todo_id}")
        if item.status == "superseded" and not any(item.metadata.get(key) for key in ("replacement", "reason")):
            errors.append(f"{where} has superseded status without replacement or reason for {item.todo_id}")
        if item.status == "archived" and not item.metadata.get("reason"):
            errors.append(f"{where} has archived status without reason for {item.todo_id}")
        if item.plan and (item.plan not in live_by_id or live_by_id[item.plan].doc_type != "plan"):
            errors.append(f"{where} references missing plan {item.plan} for {item.todo_id}")
        if item.brief and (item.brief not in live_by_id or live_by_id[item.brief].doc_type != "implementation-brief"):
            errors.append(f"{where} references missing brief {item.brief} for {item.todo_id}")
        for key in ("depends", "depends_on", "blocker", "blocked_by", "blocks"):
            value = item.metadata.get(key, "")
            if not value or not value.startswith("TODO-"):
                continue
            for ref_id in re.split(r"[, ]+", value):
                ref_id = ref_id.strip()
                if ref_id.startswith("TODO-") and ref_id not in by_id and not find_todo(structured, ref_id):
                    errors.append(f"{where} references missing todo {ref_id} in {key} for {item.todo_id}")
        if strict and not item.skill:
            warnings.append(f"{where} has no skill metadata for {item.todo_id}")
        if strict and item.status in {"blocked", "ready"} and not item.metadata.get("updated"):
            warnings.append(f"{where} has no updated metadata for {item.todo_id}")

    return errors, warnings


def check_todos(docs: list[Doc], use_json: bool = False, strict: bool = False) -> int:
    errors, warnings = todo_validation_issues(docs, strict=strict)
    payload = {"errors": errors, "warnings": warnings}
    if use_json:
        print(json.dumps(payload, indent=2))
    else:
        for warning in warnings:
            print(f"WARN: {warning}", file=sys.stderr)
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        if not errors and not warnings:
            print("No todo issues found.")
    return 1 if errors else 0


def split_markdown_table_row(line: str) -> list[str]:
    stripped = line.strip()
    if not stripped.startswith("|") or not stripped.endswith("|"):
        return []
    cells: list[str] = []
    current: list[str] = []
    escaped = False
    for char in stripped[1:-1]:
        if escaped:
            current.append(char)
            escaped = False
            continue
        if char == "\\":
            escaped = True
            current.append(char)
            continue
        if char == "|":
            cells.append("".join(current).strip().replace("\\|", "|"))
            current = []
            continue
        current.append(char)
    cells.append("".join(current).strip().replace("\\|", "|"))
    return cells


def is_markdown_table_separator(cells: list[str]) -> bool:
    return bool(cells) and all(re.fullmatch(r":?-{3,}:?", cell.strip()) for cell in cells)


def audit_findings_for_doc(doc: Doc) -> list[AuditFinding]:
    findings: list[AuditFinding] = []
    try:
        text = doc.path.read_text(encoding="utf-8")
    except OSError:
        text = doc.content
    ignored_ranges = markdown_ignored_ranges(text)
    lines = text.splitlines(keepends=True)
    offset = 0
    index = 0
    while index < len(lines):
        line = lines[index]
        row_offset = offset
        offset += len(line)
        if in_ignored_markdown_range(row_offset, ignored_ranges):
            index += 1
            continue
        cells = split_markdown_table_row(line)
        if cells != AUDIT_FINDING_HEADER:
            index += 1
            continue
        if index + 1 >= len(lines):
            index += 1
            continue
        separator_cells = split_markdown_table_row(lines[index + 1])
        if not is_markdown_table_separator(separator_cells):
            index += 1
            continue

        offset += len(lines[index + 1])
        index += 2
        while index < len(lines):
            row = lines[index]
            row_offset = offset
            offset += len(row)
            if in_ignored_markdown_range(row_offset, ignored_ranges):
                index += 1
                continue
            row_cells = split_markdown_table_row(row)
            if len(row_cells) != len(AUDIT_FINDING_HEADER):
                if row.strip().startswith("|") and row_cells:
                    row_line = line_number(text, row_offset)
                    padded = row_cells + [""] * len(AUDIT_FINDING_HEADER)
                    findings.append(
                        AuditFinding(
                            audit_path=doc.relpath,
                            line=row_line,
                            finding_id=padded[0] or f"ROW-{row_line}",
                            severity=padded[1],
                            status=padded[2],
                            finding=padded[3],
                            route=padded[4],
                            follow_up=padded[5],
                            resolution=padded[6],
                            raw=row.strip(),
                            malformed=True,
                        )
                    )
                    index += 1
                    continue
                break
            findings.append(
                    AuditFinding(
                        audit_path=doc.relpath,
                        line=line_number(text, row_offset),
                    finding_id=row_cells[0],
                    severity=row_cells[1],
                    status=row_cells[2],
                    finding=row_cells[3],
                    route=row_cells[4],
                    follow_up=row_cells[5],
                    resolution=row_cells[6],
                    raw=row.strip(),
                )
            )
            index += 1
        continue
    return findings


def audit_findings(docs: list[Doc]) -> list[AuditFinding]:
    findings: list[AuditFinding] = []
    for doc in docs:
        if doc.doc_type == "repo-health-audit":
            findings.extend(audit_findings_for_doc(doc))
    return findings


def review_item(
    item_type: str,
    code: str,
    severity: str,
    status: str,
    reference: str,
    source: str,
    line: int,
    message: str,
    detail: str = "",
    route: str = "",
    follow_up: str = "",
    updated_at: str = "",
    age_days: int | None = None,
) -> ReviewItem:
    return ReviewItem(
        item_type=item_type,
        code=code,
        severity=severity,
        status=status,
        reference=reference,
        source=source,
        line=line,
        message=message,
        detail=detail,
        route=route,
        follow_up=follow_up,
        updated_at=updated_at,
        age_days=age_days,
    )


def resolve_follow_up_target(value: str, finding: AuditFinding, root: Path, docs: list[Doc], todos: list[TodoItem]) -> tuple[str, str, Doc | None, TodoItem | None]:
    follow_up = value.strip()
    if not follow_up:
        return "missing", "empty", None, None
    if is_external_href(follow_up):
        return "ok", "external", None, None
    md_link = re.fullmatch(r"\[[^\]\n]*\]\((\S+)(?:\s+(?:\"[^\"]*\"|'[^']*'|[^)]*))?\)", follow_up)
    if md_link:
        href = md_link.group(1)
        if is_external_href(href):
            return "ok", "external", None, None
        audit_doc = next((doc for doc in docs if doc.relpath == finding.audit_path), None)
        source = audit_doc.path if audit_doc else root / finding.audit_path
        target, target_rel, status, fragment = resolve_href(href, source, root)
        if status in {"ok", "root-relative", "absolute-repo-local"} and target:
            try:
                rel = target.resolve().relative_to(root.resolve()).as_posix()
                target_doc = next((doc for doc in docs if doc.relpath == rel and not doc.is_id_retirement), None)
                if next((doc for doc in docs if doc.relpath == rel and doc.is_id_retirement), None):
                    return "missing", rel, None, None
                if not markdown_anchor_exists(target, fragment):
                    return "invalid-fragment", fragment, target_doc, None
                return "ok", target_rel or rel, target_doc, None
            except ValueError:
                return "ok", target_rel or status, None, None
        return "missing", target_rel or status, None, None
    if follow_up.startswith("TODO-"):
        todo = next((item for item in todos if item.todo_id == follow_up), None)
        return ("ok" if todo else "missing"), "todo", None, todo
    if re.fullmatch(r"[A-Z]+-\d{4}(?:-\d{2})?", follow_up):
        doc = find_doc(docs, follow_up)
        return ("ok" if doc else "missing"), "stable-id", doc, None
    if follow_up.endswith(".md") or "/" in follow_up:
        path_value, _, fragment = split_href(follow_up)
        path = resolve_path_input(path_value, root, docs)
        if not path.exists():
            return "missing", relative_to_root(path, root), None, None
        rel = relative_to_root(path, root)
        target_doc = next((doc for doc in docs if doc.relpath == rel and not doc.is_id_retirement), None)
        if next((doc for doc in docs if doc.relpath == rel and doc.is_id_retirement), None):
            return "missing", rel, None, None
        if not markdown_anchor_exists(path, fragment):
            return "invalid-fragment", fragment, target_doc, None
        return "ok", rel, target_doc, None
    return "invalid", "unstructured", None, None


def follow_up_review_item(finding: AuditFinding, root: Path, docs: list[Doc], todos: list[TodoItem], stale_days: int) -> ReviewItem | None:
    target_status, detail, doc, todo = resolve_follow_up_target(finding.follow_up, finding, root, docs, todos)
    source = f"{finding.audit_path}:{finding.line}"
    severity = finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "medium"
    target_updated_at = ""
    target_age_days: int | None = None
    if target_status == "missing":
        return review_item("audit-findings", "missing-follow-up", severity, "routed", finding.reference, source, finding.line, f"Missing follow-up {finding.follow_up}", detail, finding.route, finding.follow_up)
    if target_status == "invalid":
        return review_item("audit-findings", "invalid-follow-up", severity, "routed", finding.reference, source, finding.line, f"Invalid follow-up target {finding.follow_up}", detail, finding.route, finding.follow_up)
    if target_status == "invalid-fragment":
        return review_item("audit-findings", "invalid-follow-up", severity, "routed", finding.reference, source, finding.line, f"Invalid follow-up fragment #{detail}", finding.follow_up, finding.route, finding.follow_up)
    target_route = "TODO" if todo else (doc.primary_id.split("-", 1)[0] if doc and doc.primary_id else "")
    if finding.route not in {"", "none"} and target_route and finding.route != target_route:
        return review_item("audit-findings", "invalid-follow-up", severity, "routed", finding.reference, source, finding.line, f"Route {finding.route} does not match follow-up {finding.follow_up}", target_route, finding.route, finding.follow_up)
    if todo:
        if todo.status == "blocked":
            return review_item("audit-findings", "blocked-follow-up", severity, "routed", finding.reference, source, finding.line, f"Follow-up {finding.follow_up} is blocked", todo.metadata.get("blocker") or todo.metadata.get("blocked_by") or todo.metadata.get("reason", ""), finding.route, finding.follow_up)
        updated_at = parse_timestamp(todo.metadata.get("updated"))
        target_updated_at = todo.metadata.get("updated", "") if isinstance(todo.metadata.get("updated"), str) else ""
        target_age_days = (dt.datetime.now().astimezone() - updated_at).days if updated_at else None
        if todo.status in {"ready", "in_progress", "review"} and updated_at and target_age_days is not None and target_age_days >= stale_days:
            return review_item("audit-findings", "stale-follow-up", severity, "routed", finding.reference, source, finding.line, f"Follow-up {finding.follow_up} is stale", f"{todo.status} since {todo.metadata.get('updated')}", finding.route, finding.follow_up, target_updated_at, target_age_days)
    if doc:
        if doc.status in {"archived", "superseded", "rejected"}:
            return review_item("audit-findings", "archived-follow-up", severity, "routed", finding.reference, source, finding.line, f"Follow-up {finding.follow_up} is {doc.status}", doc.relpath, finding.route, finding.follow_up)
        if doc.status == "blocked":
            return review_item("audit-findings", "blocked-follow-up", severity, "routed", finding.reference, source, finding.line, f"Follow-up {finding.follow_up} is blocked", doc.relpath, finding.route, finding.follow_up)
        updated_at = parse_timestamp(doc.frontmatter.get("updated_at"))
        target_updated_at = doc.frontmatter.get("updated_at", "") if isinstance(doc.frontmatter.get("updated_at"), str) else ""
        target_age_days = (dt.datetime.now().astimezone() - updated_at).days if updated_at else None
        if doc.status in {"ready", "in_progress", "in-progress", "open", "investigating", "active"} and updated_at and target_age_days is not None and target_age_days >= stale_days:
            return review_item("audit-findings", "stale-follow-up", severity, "routed", finding.reference, source, finding.line, f"Follow-up {finding.follow_up} is stale", doc.relpath, finding.route, finding.follow_up, target_updated_at, target_age_days)
    return None


def has_deferred_reason_and_trigger(resolution: str) -> bool:
    text = resolution.lower()
    has_reason = bool(re.search(r"\b(because|reason|due to|blocked by|waiting for)\b", text))
    has_trigger = bool(re.search(r"\b(revisit|until|after|when|before|by|next)\b", text))
    return has_reason and has_trigger


def has_accepted_risk_rationale_and_owner(resolution: str) -> bool:
    text = resolution.lower()
    has_owner = "owner" in text
    has_rationale = bool(re.search(r"\b(because|rationale|due to|tradeoff|accepted by|accepted because)\b", text))
    return has_owner and has_rationale


def audit_review_items(root: Path, docs: list[Doc], stale_days: int) -> list[ReviewItem]:
    items: list[ReviewItem] = []
    findings = audit_findings(docs)
    todos = todo_items(docs, include_done=True)
    audit_docs_by_path = {doc.relpath: doc for doc in docs if doc.doc_type == "repo-health-audit"}
    now = dt.datetime.now().astimezone()
    seen_by_audit: dict[tuple[str, str], AuditFinding] = {}
    for finding in findings:
        source = f"{finding.audit_path}:{finding.line}"
        key = (finding.audit_path, finding.finding_id)
        if finding.malformed:
            items.append(
                review_item(
                    "audit-findings",
                    "invalid-audit-finding",
                    finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "high",
                    "invalid",
                    finding.reference,
                    source,
                    finding.line,
                    "Malformed audit finding row",
                    "Row does not match the required audit finding table shape.",
                    "",
                    "",
                )
            )
            continue
        if key in seen_by_audit:
            items.append(
                review_item(
                    "audit-findings",
                    "duplicate-audit-finding",
                    "high",
                    "invalid",
                    finding.reference,
                    source,
                    finding.line,
                    f"Duplicate finding ID {finding.finding_id}",
                    f"First seen at {seen_by_audit[key].audit_path}:{seen_by_audit[key].line}",
                    finding.route,
                    finding.follow_up,
                )
            )
        else:
            seen_by_audit[key] = finding

        if finding.severity not in AUDIT_FINDING_SEVERITIES:
            items.append(
                review_item(
                    "audit-findings",
                    "invalid-audit-finding",
                    "high",
                    "invalid",
                    finding.reference,
                    source,
                    finding.line,
                    f"Invalid severity {finding.severity!r}",
                    "",
                    finding.route,
                    finding.follow_up,
                )
            )
        if finding.status not in AUDIT_FINDING_STATUSES:
            items.append(
                review_item(
                    "audit-findings",
                    "invalid-audit-finding",
                    finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "high",
                    "invalid",
                    finding.reference,
                    source,
                    finding.line,
                    f"Invalid status {finding.status!r}",
                    "",
                    finding.route,
                    finding.follow_up,
                )
            )
        if finding.route not in AUDIT_FINDING_ROUTES:
            items.append(
                review_item(
                    "audit-findings",
                    "invalid-audit-finding",
                    finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "high",
                    "invalid",
                    finding.reference,
                    source,
                    finding.line,
                    f"Invalid route {finding.route!r}",
                    "",
                    finding.route,
                    finding.follow_up,
                )
            )

        valid_status = finding.status in AUDIT_FINDING_STATUSES
        if valid_status and finding.status == "open":
            items.append(
                review_item(
                    "audit-findings",
                    "open-audit-finding",
                    finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "medium",
                    "open",
                    finding.reference,
                    source,
                    finding.line,
                    finding.finding,
                    "",
                    finding.route,
                    finding.follow_up,
                )
            )
        if valid_status and finding.status == "routed":
            if not finding.follow_up:
                items.append(review_item("audit-findings", "missing-follow-up", "high", "invalid", finding.reference, source, finding.line, "Routed finding has no follow-up", "", finding.route, finding.follow_up))
            else:
                issue = follow_up_review_item(finding, root, docs, todos, stale_days)
                if issue:
                    items.append(issue)
        if valid_status and finding.status == "resolved" and not finding.resolution:
            items.append(review_item("audit-findings", "invalid-audit-finding", "medium", "invalid", finding.reference, source, finding.line, "Resolved finding has no resolution evidence", "", finding.route, finding.follow_up))
        if valid_status and finding.status == "deferred" and not has_deferred_reason_and_trigger(finding.resolution):
            items.append(review_item("audit-findings", "invalid-audit-finding", "medium", "invalid", finding.reference, source, finding.line, "Deferred finding needs reason and revisit trigger", "", finding.route, finding.follow_up))
        if valid_status and finding.status == "accepted-risk":
            if finding.route != "none":
                items.append(review_item("audit-findings", "invalid-audit-finding", "medium", "invalid", finding.reference, source, finding.line, "Accepted risk must use Route = none", "", finding.route, finding.follow_up))
            if not has_accepted_risk_rationale_and_owner(finding.resolution):
                items.append(review_item("audit-findings", "invalid-audit-finding", "medium", "invalid", finding.reference, source, finding.line, "Accepted risk needs rationale and owner", "", finding.route, finding.follow_up))
        if valid_status and finding.status == "archived" and not finding.resolution:
            items.append(review_item("audit-findings", "invalid-audit-finding", "low", "invalid", finding.reference, source, finding.line, "Archived finding has no reason", "", finding.route, finding.follow_up))
        if valid_status and finding.status in {"deferred", "accepted-risk"} and finding.resolution:
            audit_doc = audit_docs_by_path.get(finding.audit_path)
            updated_at = parse_timestamp(audit_doc.frontmatter.get("updated_at")) if audit_doc else None
            if updated_at and (now - updated_at).days >= stale_days:
                updated_at_value = audit_doc.frontmatter.get("updated_at", "") if audit_doc and isinstance(audit_doc.frontmatter.get("updated_at"), str) else ""
                age_days = (now - updated_at).days
                items.append(review_item("audit-findings", "due-review", finding.severity if finding.severity in AUDIT_FINDING_SEVERITIES else "medium", finding.status, finding.reference, source, finding.line, f"{finding.status} finding is due for review", f"Audit updated {age_days} days ago", finding.route, finding.follow_up, updated_at_value, age_days))
    return items


def todo_review_items(docs: list[Doc], stale_days: int) -> list[ReviewItem]:
    items: list[ReviewItem] = []
    now = dt.datetime.now().astimezone()
    for item in todo_items(docs, include_done=False):
        if not item.structured:
            continue
        source = f"{item.path}:{item.line}"
        if item.status == "blocked":
            items.append(review_item("todos", "blocked-todo", "medium", "blocked", item.todo_id, source, item.line, item.task, item.metadata.get("blocker") or item.metadata.get("blocked_by") or item.metadata.get("reason", ""), "", item.todo_id))
            continue
        if item.status in {"ready", "in_progress", "review"}:
            updated_at = parse_timestamp(item.metadata.get("updated"))
            age_days = (now - updated_at).days if updated_at else None
            updated_at_value = item.metadata.get("updated", "") if isinstance(item.metadata.get("updated"), str) else ""
            if updated_at and age_days is not None and age_days >= stale_days:
                items.append(review_item("todos", "stale-todo", "medium", "stale", item.todo_id, source, item.line, item.task, f"{item.status} for {age_days} days", "", item.todo_id, updated_at_value, age_days))
    return items


def doc_review_items(docs: list[Doc], stale_days: int) -> list[ReviewItem]:
    items: list[ReviewItem] = []
    now = dt.datetime.now().astimezone()
    stale_doc_types = {"plan", "implementation-brief", "question", "diagnostic-record", "research-survey", "evaluation"}
    stale_statuses = {"ready", "in_progress", "in-progress", "blocked", "open", "investigating", "active"}
    archived_statuses = {"archived", "rejected", "superseded", "completed", "resolved", "answered", "implemented"}
    for doc in docs:
        if doc.doc_type not in stale_doc_types or doc.status in archived_statuses or doc.status not in stale_statuses:
            continue
        updated_at = parse_timestamp(doc.frontmatter.get("updated_at"))
        if not updated_at:
            continue
        age_days = (now - updated_at).days
        if age_days < stale_days:
            continue
        reference = doc.primary_id or doc.relpath
        items.append(
            review_item(
                "docs",
                "stale-doc",
                "medium" if doc.status == "blocked" else "info",
                "stale",
                reference,
                doc.relpath,
                1,
                f"{reference} is {doc.status} and has not been updated in {age_days} days.",
                f"Threshold: {stale_days} days",
                "",
                "",
                doc.frontmatter.get("updated_at", "") if isinstance(doc.frontmatter.get("updated_at"), str) else "",
                age_days,
            )
        )
    return items


def filter_review_items(items: list[ReviewItem], args: argparse.Namespace) -> list[ReviewItem]:
    selected = items
    if getattr(args, "type", None):
        selected = [item for item in selected if item.item_type == args.type]
    if getattr(args, "status", None):
        selected = [item for item in selected if item.status == args.status]
    if getattr(args, "severity", None):
        selected = [item for item in selected if item.severity == args.severity]
    selected = sorted(
        selected,
        key=review_sort_key,
    )
    if getattr(args, "limit", None):
        selected = selected[: args.limit]
    return selected


def review_items(root: Path, docs: list[Doc], stale_days: int) -> list[ReviewItem]:
    return audit_review_items(root, docs, stale_days) + todo_review_items(docs, stale_days) + doc_review_items(docs, stale_days)


def review_group_label(item: ReviewItem) -> str:
    if item.code == "open-audit-finding":
        if item.severity in {"critical", "high"}:
            return REVIEW_DYNAMIC_GROUPS["open-high-critical"]
        return REVIEW_DYNAMIC_GROUPS["open-other"]
    for label, codes in REVIEW_GROUPS:
        if item.code in codes:
            return label
    return "Other review items"


def review_group_index(item: ReviewItem) -> int:
    return REVIEW_GROUP_ORDER.get(review_group_label(item), REVIEW_GROUP_ORDER["Other review items"])


def review_sort_timestamp(item: ReviewItem) -> float:
    parsed = parse_timestamp(item.updated_at)
    if not parsed:
        return 0
    return parsed.timestamp()


def review_sort_key(item: ReviewItem) -> tuple[int, int, int, float, str, str, str]:
    return (
        review_group_index(item),
        REVIEW_SEVERITY_RANK.get(item.severity, 9),
        REVIEW_STATUS_RANK.get(item.status, 9),
        review_sort_timestamp(item),
        item.source,
        item.reference,
        item.code,
    )


def validate_document_identity(doc: Doc) -> list[str]:
    errors: list[str] = []
    raw_version = doc.frontmatter.get("document_format_version")
    if raw_version in (None, ""):
        return errors
    if doc.document_format_version != DOCUMENT_FORMAT_VERSION:
        errors.append(
            f"Unsupported document_format_version {raw_version!r} in {doc.relpath}; expected {DOCUMENT_FORMAT_VERSION}"
        )
        return errors
    if not is_uuid7(doc.canonical_id):
        errors.append(f"Document format v2 requires an RFC UUIDv7 id in {doc.relpath}")
    aliases = doc.frontmatter.get("aliases")
    if not isinstance(aliases, list):
        errors.append(f"Document format v2 requires an aliases list in {doc.relpath}")
    elif len(doc.aliases) != len(set(doc.aliases)):
        errors.append(f"Document format v2 contains duplicate aliases in {doc.relpath}")
    return errors


def validate_identity_graph(docs: list[Doc]) -> list[str]:
    errors: list[str] = []
    canonical: dict[str, str] = {}
    lookup: dict[str, str] = {}
    for doc in docs:
        if doc.canonical_id:
            previous = canonical.get(doc.canonical_id)
            if previous:
                errors.append(f"Duplicate canonical ID {doc.canonical_id}: {previous} and {doc.relpath}")
            canonical[doc.canonical_id] = doc.relpath
        for identity in doc.identity_keys:
            previous = lookup.get(identity)
            if previous:
                errors.append(f"Ambiguous document identity or alias {identity}: {previous} and {doc.relpath}")
            lookup[identity] = doc.relpath
    return errors


def format_review_items(items: list[ReviewItem], width: int | None = None) -> str:
    if not items:
        return "No review items found."
    output_width = width or shutil.get_terminal_size((120, 24)).columns
    rows = []
    current_group = ""
    for item in sorted(items, key=review_sort_key):
        group = review_group_label(item)
        if group != current_group:
            if rows:
                rows.append("")
            rows.append(group)
            current_group = group
        message = item.message
        max_message = max(24, output_width - 72)
        if len(message) > max_message:
            message = message[: max_message - 1] + "…"
        rows.append(
            "\t".join(
                [
                    item.severity,
                    item.status,
                    item.code,
                    item.reference,
                    item.follow_up,
                    item.source,
                    message,
                ]
            ).rstrip()
        )
    return "\n".join(rows)


def validate_frontmatter(doc: Doc, docs: list[Doc] | None = None) -> list[str]:
    errors: list[str] = []
    doc_type = doc.doc_type
    if not doc_type:
        return errors
    if doc_type not in KNOWN_DOC_TYPES:
        errors.append(f"Unknown frontmatter type {doc_type!r} in {doc.relpath}")
        return errors

    errors.extend(validate_document_identity(doc))

    required = REQUIRED_FIELDS_BY_TYPE.get(doc_type, set())
    missing = sorted(field for field in required if field not in doc.frontmatter)
    for field in missing:
        errors.append(f"Missing frontmatter field {field!r} in {doc.relpath}")

    allowed_statuses = STATUS_BY_TYPE.get(doc_type, COMMON_STATUSES)
    if doc.status and doc.status not in allowed_statuses:
        errors.append(f"Unknown status {doc.status!r} for type {doc_type!r} in {doc.relpath}")

    if doc_type == "architecture-area":
        doc_id = doc.primary_id
        if doc_id and doc.path.stem != doc_id:
            errors.append(f"Architecture area ID {doc_id} must match filename stem in {doc.relpath}")

    frontmatter_id = doc.frontmatter.get("id")
    if doc.document_format_version == 1 and isinstance(frontmatter_id, str) and frontmatter_id:
        filename_ids = set(find_ids(doc.path.name))
        family = frontmatter_id.split("-", 1)[0]
        mismatches = sorted(doc_id for doc_id in filename_ids if doc_id.startswith(f"{family}-") and doc_id != frontmatter_id)
        for mismatch in mismatches:
            errors.append(f"Frontmatter ID {frontmatter_id} conflicts with filename ID {mismatch} in {doc.relpath}")

    if doc_type == "implementation-brief":
        parent = doc.frontmatter.get("parent_plan")
        doc_id = doc.primary_id
        if isinstance(parent, str) and parent and doc_id.startswith("IMPL-"):
            expected = f"IMPL-{parent.split('-')[-1]}-"
            if not doc_id.startswith(expected):
                errors.append(f"Implementation ID {doc_id} does not match parent_plan {parent} in {doc.relpath}")

    if doc_type == "id-retirement":
        retired_id = doc.primary_id
        if not re.fullmatch(r"IMPL-\d{4}-\d{2}", retired_id):
            errors.append(f"ID retirement {doc.relpath} must use id IMPL-####-##")
        else:
            expected_path = f"id-retirements/{retired_id}.md"
            if doc.relpath != expected_path:
                errors.append(f"ID retirement {retired_id} must live at {expected_path}")
        if doc.status != "retired":
            errors.append(f"ID retirement {doc.primary_id or doc.relpath} must use status retired")
        parent = doc.frontmatter.get("parent_plan")
        if not isinstance(parent, str) or not re.fullmatch(r"PLAN-\d{4}", parent):
            errors.append(f"ID retirement {doc.primary_id or doc.relpath} must include parent_plan PLAN-####")
        else:
            if re.fullmatch(r"IMPL-\d{4}-\d{2}", retired_id):
                if retired_id.split("-")[1] != parent.split("-")[1]:
                    errors.append(f"ID retirement {retired_id} does not match parent_plan {parent}")
            parent_doc = find_doc(docs or [], parent)
            if not parent_doc or parent not in parent_doc.identity_keys or parent_doc.doc_type != "plan":
                errors.append(f"ID retirement {doc.primary_id or doc.relpath} must reference a live primary plan: {parent}")
        reason = doc.frontmatter.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            errors.append(f"ID retirement {doc.primary_id or doc.relpath} must include a non-empty reason")
        source = doc.frontmatter.get("source")
        source_map = source if isinstance(source, dict) else {}
        source_type = source_map.get("type")
        source_link = source_map.get("link")
        source_notes = source_map.get("notes")
        if not isinstance(source_type, str) or not source_type.strip():
            errors.append(f"ID retirement {doc.primary_id or doc.relpath} must include non-empty source.type")
        if not any(isinstance(value, str) and value.strip() for value in (source_link, source_notes)):
            errors.append(f"ID retirement {doc.primary_id or doc.relpath} must include non-empty source.link or source.notes")

    if doc_type == "learning" and doc.status == "superseded":
        superseded_by = doc.frontmatter.get("superseded_by")
        reason = doc.frontmatter.get("reason")
        has_replacement = (isinstance(superseded_by, list) and bool(superseded_by)) or (
            isinstance(superseded_by, str) and bool(superseded_by)
        )
        if not has_replacement and not reason:
            errors.append(f"Superseded learning {doc.primary_id or doc.relpath} must include superseded_by or reason in {doc.relpath}")

    if doc_type == "question":
        if doc.status == "answered" and not doc.frontmatter.get("resolution") and not doc.frontmatter.get("resolved_by"):
            errors.append(f"Answered question {doc.primary_id or doc.relpath} must include resolution or resolved_by in {doc.relpath}")
        if doc.status == "superseded":
            superseded_by = doc.frontmatter.get("superseded_by")
            reason = doc.frontmatter.get("reason")
            has_replacement = (isinstance(superseded_by, list) and bool(superseded_by)) or (
                isinstance(superseded_by, str) and bool(superseded_by)
            )
            if not has_replacement and not reason:
                errors.append(f"Superseded question {doc.primary_id or doc.relpath} must include superseded_by or reason in {doc.relpath}")

    if doc_type == "repo-health-audit":
        doc_id = doc.primary_id
        if not re.fullmatch(r"AUDT-\d{4}", doc_id):
            errors.append(f"Audit {doc.relpath} must use id AUDT-####")
        audit_kind = doc.frontmatter.get("audit_kind")
        if audit_kind not in AUDIT_KINDS:
            errors.append(f"Unknown audit_kind {audit_kind!r} in {doc.relpath}; choose one of: {', '.join(sorted(AUDIT_KINDS))}")
        if doc.status == "completed" and not doc.frontmatter.get("audit_ended_at"):
            errors.append(f"Completed audit {doc.relpath} must include audit_ended_at")

    return errors


def validate_linked_paths(doc: Doc, root: Path) -> list[str]:
    errors: list[str] = []
    for linked in as_string_list(doc.frontmatter.get("linked_paths")):
        info = linked_path_info(linked, root)
        if info["status"] != "ok":
            errors.append(f"linked_paths entry {linked!r} is {info['status']} in {doc.relpath}")
    return errors


def main() -> int:
    args = parse_args()
    root = docs_root(args.root)
    if args.command == "format-status":
        payload = format_status_payload(root, args.exclude)
        print_json_or_text(payload, format_status_text(payload), args.json)
        return 0
    if args.command == "migrate-uuids":
        if args.prepare_plan:
            payload = prepare_uuid_migration(root, args.prepare_plan, args.exclude, bool(args.write))
            summary = (
                f"{'WROTE' if args.write else 'PREVIEW'} migration plan {args.prepare_plan}\n"
                f"Documents: {len(payload['documents'])}\n"
                f"Migration ID: {payload['migration_id']}"
            )
        else:
            payload = apply_uuid_migration(root, args.plan, bool(args.write))
            summary = (
                f"Migration state: {payload['state']}\n"
                f"Plan: {payload['plan_path']}\n"
                f"Receipt: {payload['receipt_path']}"
            )
        print_json_or_text(payload, summary, args.json)
        return 0
    if args.command == "retire-id":
        return retire_id(args, root)
    docs = read_docs(root)

    if args.command == "next":
        if args.family == "todo":
            print(next_todo_id(docs))
            return 0
        print(next_id(args.family, docs, args.plan))
        return 0
    if args.command == "new":
        path = new_doc(args, root, docs)
        print(path)
        return 0
    if args.command == "status":
        selected = [find_any_doc(docs, args.id)] if args.id else [doc for doc in docs if doc.primary_id]
        for doc in selected:
            if doc:
                print(f"{doc.primary_id or doc.relpath}\t{doc.status or '(none)'}\t{doc.relpath}")
        return 0
    if args.command == "show":
        doc = find_any_doc(docs, args.id)
        if not doc:
            candidate = resolve_path_input(args.id, root, docs)
            try:
                rel = candidate.resolve().relative_to(root.resolve()).as_posix()
            except ValueError:
                raise SystemExit(f"No document found for {args.id}")
            doc = next((item for item in docs if item.relpath == rel), None)
        if not doc:
            raise SystemExit(f"No document found for {args.id}")
        payload = show_doc(doc, docs, root)
        print_json_or_text(payload, show_doc_text(payload), args.json)
        return 0
    if args.command == "set-status":
        doc = find_any_doc(docs, args.id)
        if not doc:
            raise SystemExit(f"No document found for {args.id}")
        set_status(doc, args.status)
        print(f"{args.id}\t{args.status}")
        return 0
    if args.command == "todos":
        if args.id and str(args.id).startswith("TODO-"):
            selected_docs = docs
        else:
            selected_docs = [find_doc(docs, args.id)] if args.id else docs
        selected_docs = [doc for doc in selected_docs if doc]
        items = todo_items(selected_docs, include_done=args.all)
        items = filter_todos(items, args)
        print_json_or_text([item.as_dict() for item in items], format_todo_rows(items), args.json)
        return 0
    if args.command == "check-todos":
        return check_todos(docs, args.json, args.strict)
    if args.command == "review":
        items = filter_review_items(review_items(root, docs, args.stale_days), args)
        print_json_or_text([item.as_dict() for item in items], format_review_items(items, args.width), args.json)
        return 0
    if args.command == "links":
        refs = link_graph(root, docs)
        if args.target:
            target_doc = find_any_doc(docs, args.target)
            target_path = resolve_path_input(args.target, root, docs).resolve()
            refs = [
                ref
                for ref in refs
                if ref.source.resolve() == target_path
                or (ref.target is not None and ref.target.resolve() == target_path)
                or (target_doc is not None and ref.source.resolve() == target_doc.path.resolve())
            ]
        print_json_or_text([ref.as_dict() for ref in refs], format_link_rows(refs), args.json)
        return 0
    if args.command == "backlinks":
        refs = link_graph(root, docs)
        target = resolve_path_input(args.target, root, docs).resolve()
        selected = [ref for ref in refs if link_matches_target(ref, target)]
        print_json_or_text([ref.as_dict() for ref in selected], format_link_rows(selected), args.json)
        return 0
    if args.command == "check-links":
        broken = broken_link_refs(link_graph(root, docs))
        print_json_or_text([ref.as_dict() for ref in broken], format_link_rows(broken), args.json)
        return 1 if broken else 0
    if args.command == "orphans":
        refs = link_graph(root, docs)
        orphaned = orphan_docs(root, docs, refs, include_generated=args.include_generated, excludes=args.exclude)
        rows = [{"path": doc.relpath, "id": doc.primary_id, "type": doc.doc_type, "title": doc.title} for doc in orphaned]
        text = "No orphan docs found." if not rows else "\n".join(f"{row['path']}\t{row['id']}\t{row['title']}" for row in rows)
        print_json_or_text(rows, text, args.json)
        return 0
    if args.command == "normalize-links":
        write = bool(args.write)
        refs = [
            ref
            for ref in link_graph(root, docs)
            if ref.status in {"absolute-repo-local", "root-relative"} and ref.target is not None
        ]
        changes = planned_link_rewrites(refs, write, id_retirement_paths(docs))
        text = "No link normalization changes." if not changes else "\n".join(
            f"{change['file']}:{change['line']}\t{change['from']} -> {change['to']}" for change in changes
        )
        print_json_or_text(changes, text, args.json)
        return 0
    if args.command == "move":
        result = perform_move(root, docs, args.old, args.new, bool(args.write), args.allow_historical)
        lines = [
            ("MOVE" if args.write else "DRY-RUN") + f"\t{result['old']} -> {result['new']}",
            "Link changes:",
        ]
        link_changes = result["link_changes"]
        if isinstance(link_changes, list) and link_changes:
            lines.extend(f"- {item['file']}:{item['line']}\t{item['from']} -> {item['to']}" for item in link_changes)
        else:
            lines.append("- none")
        mentions = result["prose_mentions"]
        if isinstance(mentions, list) and mentions:
            lines.append("Prose mentions to review:")
            lines.extend(f"- {item['file']}:{item['line']}\t{item['text']}" for item in mentions)
        print_json_or_text(result, "\n".join(lines), args.json)
        return 0
    if args.command == "update":
        update(root, docs)
        return 0
    if args.command == "check":
        return check(root, docs)
    if args.command == "health":
        issues = health_issues(root, docs, args.stale_days, args.commit_threshold, args.audit_days)
        markdown = generated_view_markdown(root, "health", docs, args)
        if args.write:
            generated_view_path(root, "health").write_text(markdown, encoding="utf-8")
        if args.json:
            print(json.dumps([issue.__dict__ for issue in issues], indent=2))
        else:
            print(health_text(issues))
        return 0
    if args.command == "roadmap":
        rows = roadmap_rows(docs)
        markdown = generated_view_markdown(root, "roadmap", docs, args)
        if args.write:
            generated_view_path(root, "roadmap").write_text(markdown, encoding="utf-8")
        if args.json:
            print(json.dumps(rows, indent=2))
        else:
            print(markdown)
        return 0
    if args.command == "view":
        markdown = write_generated_view(root, args.name, docs, args)
        print(markdown)
        return 0
    raise SystemExit(f"Unknown command: {args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
