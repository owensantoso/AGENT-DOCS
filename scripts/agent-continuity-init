MANIFEST_SCHEMA_VERSION = 2
DOCUMENT_FORMAT_TARGET = 2
AGENT_CONTINUITY_RELEASE = (REPO_ROOT / "VERSION").read_text(encoding="utf-8").strip()
ANSI_PATTERN = re.compile(r"\033\[[0-9;]*m")
ANSI_RESET = "\033[0m"
IMPORTANT_DOCS = {"AGENTS.md", "ARCHITECTURE.md", "CURRENT_STATE.md", "ROADMAP.md"}
IMPORTANT_FOLDERS = {("docs", "orientation")}
QUIET_FOLDERS = {("scripts",), ("tests",)}
DETAIL_LEFT_WIDTH = 52
DETAIL_GAP = 4
AGENT_CONTINUITY_OWNED_PATHS = {
    Path("scripts/agent-continuity-docs"),
    Path("tests/agent-continuity-docs-smoke.sh"),
    Path("scripts/docs-meta"),
    Path("tests/docs-meta-smoke.sh"),
}
MANIFEST_PATH = Path(".agent-continuity/manifest.json")
LEGACY_MANIFEST_PATH = Path(".agent-docs/manifest.json")
DOCS_TOOLING_UPDATE_GENERATOR = "agent-continuity docs update"
LEGACY_DOCS_META_UPDATE_GENERATOR = "scripts/docs-meta update"
DOCS_TOOLING_UPDATE_OUTPUTS = {
    Path("docs/IDEAS.md"),
    Path("docs/CONCEPTS.md"),
    Path("docs/SPECS.md"),
