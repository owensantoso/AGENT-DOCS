    Path("docs/QUESTIONS.md"),
    Path("docs/DOCS-REGISTRY.md"),
    Path("docs/TODOS.md"),
    Path("docs/AREAS.md"),
    Path("docs/AUDITS.md"),
    Path("docs/ROADMAP-VIEW.md"),
}


@dataclass(frozen=True)
class Profile:
    key: str
    label: str
    summary: str
    template_summary: str
    template_groups: tuple[tuple[str, tuple[tuple[str, str], ...]], ...]
    implications: tuple[str, ...]
    structure: tuple[str, ...]
    docs_tooling_default: bool


PUBLIC_PROFILE_KEYS = ("core", "standard", "expanded", "complete")
PROFILE_ALIASES = {
    "tiny": "core",
    "small": "standard",
    "growing": "expanded",
    "full": "complete",
}


